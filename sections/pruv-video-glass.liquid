<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700;800&family=Geist+Mono:wght@600;700&display=swap"
  rel="stylesheet"
>
{{ 'section-pruv-video-glass.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #pruv-video-frame-{{ section.id }} .pruv-video-glass__overlay {
    background-color: {{ section.settings.overlay_color | default: '#000000' }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  {%- if section.settings.glass_blur_strength != blank -%}
    #pruv-video-frame-{{ section.id }} .pruv-video-glass__card {
      -webkit-backdrop-filter: blur({{ section.settings.glass_blur_strength }}px) saturate(180%);
      backdrop-filter: blur({{ section.settings.glass_blur_strength }}px) saturate(180%);
    }
  {%- endif -%}

  {%- if section.settings.glass_opacity != blank -%}
    #pruv-video-frame-{{ section.id }} .pruv-video-glass__card--light {
      background: rgba(255, 255, 255, {{ section.settings.glass_opacity | divided_by: 100.0 }});
    }
    #pruv-video-frame-{{ section.id }} .pruv-video-glass__card--dark {
      background: rgba(25, 23, 18, {{ section.settings.glass_opacity | divided_by: 100.0 }});
    }
    #pruv-video-frame-{{ section.id }} .pruv-video-glass__card--terracotta {
      background: rgba(168, 95, 46, {{ section.settings.glass_opacity | divided_by: 100.0 }});
    }
  {%- endif -%}
{%- endstyle -%}

<div class="pruv-video-glass color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="pruv-video-glass__container page-width">

    <div
      id="pruv-video-frame-{{ section.id }}"
      class="pruv-video-glass__frame pruv-video-glass__frame--{{ section.settings.height | default: 'medium' }}"
      data-animate="fade-up"
    >
      <!-- Background Video / Media -->
      <div class="pruv-video-glass__media">
        {%- if section.settings.video != blank -%}
          {{
            section.settings.video
            | video_tag:
              image_size: '1800x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              class: 'pruv-video-glass__video'
          }}
        {%- elsif section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1800',
              class: 'pruv-video-glass__image',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- else -%}
          <div class="pruv-video-glass__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <!-- Video Tint Overlay -->
      <div class="pruv-video-glass__overlay"></div>

      <!-- Frosted Glass Center Card Overlay -->
      <div class="pruv-video-glass__card-wrapper pruv-video-glass__card-wrapper--{{ section.settings.card_position | default: 'center' }}">
        <div class="pruv-video-glass__card pruv-video-glass__card--{{ section.settings.glass_style | default: 'light' }}">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pruv-video-glass__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="pruv-video-glass__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="pruv-video-glass__text rte">{{ section.settings.text }}</div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="pruv-video-glass__button-wrapper">
              <a
                {% if section.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link }}"
                {% endif %}
                class="pruv-video-glass__btn pruv-video-glass__btn--{{ section.settings.button_style | default: 'glass' }}"
              >
                {{- section.settings.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Prüv video showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Video & Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Upload an MP4/MOV file directly in Shopify. Autoplays muted on loop."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image / Poster",
      "info": "Shown while video is loading or if no video is selected."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to widescreen (21:9)"
        },
        {
          "value": "small",
          "label": "Small (400px)"
        },
        {
          "value": "medium",
          "label": "Medium (520px)"
        },
        {
          "value": "large",
          "label": "Large (640px)"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Video overlay tint",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Video overlay opacity",
      "default": 10
    },
    {
      "type": "header",
      "content": "Frosted Glass Card"
    },
    {
      "type": "select",
      "id": "glass_style",
      "label": "Glass card theme",
      "options": [
        {
          "value": "light",
          "label": "Frosted Light (As in Reference)"
        },
        {
          "value": "dark",
          "label": "Frosted Dark Onyx"
        },
        {
          "value": "terracotta",
          "label": "Frosted Terracotta"
        }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "glass_blur_strength",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Glass blur strength",
      "default": 24
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Glass card opacity",
      "default": 15
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "Card position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "bottom",
          "label": "Bottom Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Give our science <strong>a spin.</strong>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description text"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "KNOW MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "glass",
          "label": "Frosted Glass Pill (As in Reference)"
        },
        {
          "value": "black",
          "label": "Solid Black Pill"
        },
        {
          "value": "terracotta",
          "label": "Signature Terracotta Pill"
        }
      ],
      "default": "glass"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Prüv video showcase",
      "settings": {
        "heading": "Give our science <strong>a spin.</strong>",
        "button_label": "KNOW MORE",
        "button_style": "glass",
        "glass_style": "light",
        "height": "medium"
      }
    }
  ]
}
{% endschema %}
