{%- liquid
  assign has_media = false
  for block in section.blocks
    if block.settings.image != blank or block.settings.video != blank
      assign has_media = true
    endif
  endfor
-%}
{%- if has_media -%}
{{ 'section-pruv-trishield.css' | asset_url | stylesheet_tag }}
<section class="pruv-ts">
  <div class="page-width">
    <div class="pruv-ts__head">
      <h2 class="pruv-ts__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="pruv-ts__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </div>
    <div class="pruv-ts__media">
      {%- for block in section.blocks -%}
        {%- if block.settings.video != blank -%}
          <figure {{ block.shopify_attributes }}>
            {{ block.settings.video | video_tag: image_size: '1100x', controls: true, loop: false, muted: false }}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
          </figure>
        {%- elsif block.settings.image != blank -%}
          <figure {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '400, 700, 1100' }}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Prüv texture & wash",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Texture and wash experience" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real texture, real lather, rinsed thoroughly." }
  ],
  "blocks": [
    { "type": "media", "name": "Media", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image (actual texture / lather)" },
      { "type": "video", "id": "video", "label": "Video (wet hair + thorough rinse)" },
      { "type": "text", "id": "caption", "label": "Caption" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Prüv texture & wash" }]
}
{% endschema %}
