{{ 'section-pruv-about-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="pruv-about-hero{% if section.settings.image != blank %} pruv-about-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="pruv-about-hero__inner page-width page-width--narrow" data-animate="fade-up">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pruv-about-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="pruv-about-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="pruv-about-hero__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  {%- if section.settings.image != blank -%}
    <div class="pruv-about-hero__media">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          widths: '750, 1100, 1500, 2000',
          class: 'pruv-about-hero__image',
          alt: section.settings.image.alt | default: section.settings.heading | escape
      }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Prüv about hero",
  "tag": "section",
  "class": "section pruv-about-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About Prüv"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Beyond doubt, <strong>beyond hard water.</strong>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>We believe great hair care starts with real science, not trends. Every Prüv formula is built and tested specifically against the hard water, humidity and pollution Indian hair deals with every day — measured, refined, and proven before it earns a place in your routine.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Leave blank for a text-only hero."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Prüv about hero"
    }
  ]
}
{% endschema %}
