{{ 'section-pruv-timeline.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="pruv-timeline color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="pruv-timeline__header page-width page-width--narrow" data-animate="fade-up">
    <div class="pruv-timeline__header-text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pruv-timeline__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pruv-timeline__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="pruv-timeline__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="pruv-timeline__container" data-timeline-container>
      <div class="pruv-timeline__track" data-timeline-track tabindex="0" role="region" aria-label="Timeline milestones">
        {%- for block in section.blocks -%}
          <div class="pruv-timeline__item" {{ block.shopify_attributes }} data-timeline-item data-index="{{ forloop.index0 }}">
            <div class="pruv-timeline__date-wrapper">
              {%- if block.settings.year != blank -%}
                <span class="pruv-timeline__year">{{ block.settings.year | escape }}</span>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span class="pruv-timeline__label">{{ block.settings.label | escape }}</span>
              {%- endif -%}
            </div>

            <div class="pruv-timeline__connector-wrapper" aria-hidden="true">
              <div class="pruv-timeline__node">
                <span class="pruv-timeline__node-dot"></span>
                <span class="pruv-timeline__node-pulse"></span>
              </div>
              {%- unless forloop.last -%}
                <div class="pruv-timeline__rail">
                  <div class="pruv-timeline__line"></div>
                  <div class="pruv-timeline__arrow-stream">
                    <span class="pruv-timeline__animated-arrow arrow-1">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </span>
                    <span class="pruv-timeline__animated-arrow arrow-2">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </span>
                  </div>
                </div>
              {%- else -%}
                <div class="pruv-timeline__rail pruv-timeline__rail--end">
                  <div class="pruv-timeline__line pruv-timeline__line--fade"></div>
                </div>
              {%- endunless -%}
            </div>

            <div class="pruv-timeline__content">
              {%- if block.settings.title != blank -%}
                <h3 class="pruv-timeline__item-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="pruv-timeline__item-description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="pruv-timeline__progress-wrapper" aria-hidden="true">
        <div class="pruv-timeline__progress-bar">
          <div class="pruv-timeline__progress-thumb" data-timeline-progress></div>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function() {
    function initTimeline(section) {
      const track = section.querySelector('[data-timeline-track]');
      if (!track) return;

      const progressThumb = section.querySelector('[data-timeline-progress]');
      const items = section.querySelectorAll('[data-timeline-item]');

      function updateControls() {
        const maxScroll = track.scrollWidth - track.clientWidth;
        const currentScroll = track.scrollLeft;

        if (progressThumb && maxScroll > 0) {
          const percentage = Math.min(Math.max((currentScroll / maxScroll) * 100, 0), 100);
          progressThumb.style.width = Math.max(percentage, 15) + '%';
          progressThumb.style.transform = 'translateX(' + (currentScroll / maxScroll * (100 - parseFloat(progressThumb.style.width))) + '%)';
        }
      }

      track.addEventListener('scroll', updateControls, { passive: true });
      window.addEventListener('resize', updateControls);
      setTimeout(updateControls, 100);

      function scrollByCard(direction) {
        const itemWidth = items[0] ? items[0].getBoundingClientRect().width + 32 : 360;
        track.scrollBy({ left: direction * itemWidth, behavior: 'smooth' });
      }

      // Mouse drag to scroll
      let isDown = false;
      let startX;
      let scrollLeft;

      track.addEventListener('mousedown', function(e) {
        isDown = true;
        track.classList.add('is-dragging');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      window.addEventListener('mouseup', function() {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('is-dragging');
      });

      track.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.6;
        track.scrollLeft = scrollLeft - walk;
      });

      // Keyboard navigation
      track.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowRight') {
          scrollByCard(1);
        } else if (e.key === 'ArrowLeft') {
          scrollByCard(-1);
        }
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.pruv-timeline').forEach(initTimeline);
    });

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', function(e) {
        if (e.target.classList.contains('pruv-timeline-section') || e.target.querySelector('.pruv-timeline')) {
          const el = e.target.classList.contains('pruv-timeline') ? e.target : e.target.querySelector('.pruv-timeline');
          if (el) initTimeline(el);
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Prüv timeline",
  "tag": "section",
  "class": "section pruv-timeline-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Journey So Far"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shaped by curiosity and <strong>commitment to better hair.</strong>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2019"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Month / label",
          "default": "FEBRUARY"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The beginning"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "It started in a kitchen with a homemade flaxseed hair gel. A simple experiment and a simple realisation: hair care could be more honest, more thoughtful, and grounded in what actually works."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Prüv timeline",
      "blocks": [
        {
          "type": "milestone",
          "settings": {
            "year": "2019",
            "label": "FEBRUARY",
            "title": "The beginning",
            "description": "It started in a kitchen with a homemade flaxseed hair gel. A simple experiment and a simple realisation: hair care could be more honest, more thoughtful, and grounded in what actually works."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2022",
            "label": "MARCH",
            "title": "From one solution to many",
            "description": "A defining moment when we received funding on Shark Tank India, strengthening our belief in science-led hair care for a wider audience and solidifying our resolve to raise the standard."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2024",
            "label": "JANUARY",
            "title": "Scaling with intent",
            "description": "Formulated specifically for Indian hard water and humid climates, expanding rituals across scalp health and bond repair with rigorous clinical testing."
          }
        },
        {
          "type": "milestone",
          "settings": {
