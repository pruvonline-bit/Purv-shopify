<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{{ 'section-pruv-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #PruvHero-{{ section.id }} {
    --hero-pos-x: {{ section.settings.canvas_pos_x | default: 15 }}%;
    --hero-pos-y: {{ section.settings.canvas_pos_y | default: 75 }}%;
    --hero-max-width: {{ section.settings.canvas_max_width | default: 640 }}px;
    --hero-mob-pos-x: {{ section.settings.mobile_canvas_pos_x | default: 50 }}%;
    --hero-mob-pos-y: {{ section.settings.mobile_canvas_pos_y | default: 85 }}%;
    --hero-mob-max-width: {{ section.settings.mobile_canvas_max_width | default: 420 }}px;
  }

  #PruvHero-{{ section.id }} .pruv-hero__media::after {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    {%- if section.settings.overlay_style == 'solid' -%}
      background: rgba(0, 0, 0, 1);
    {%- elsif section.settings.overlay_style == 'subtle-bottom' -%}
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.85) 100%);
    {%- elsif section.settings.overlay_style == 'light-gradient' -%}
      background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.7) 100%);
    {%- else -%}
      background: linear-gradient(180deg, rgba(20, 20, 20, 0.15) 0%, rgba(15, 15, 18, 0.82) 100%);
    {%- endif -%}
  }

  {%- if section.settings.button_custom_bg != blank -%}
    #PruvHero-{{ section.id }} .button--hero-primary {
      background: {{ section.settings.button_custom_bg }} !important;
      background-color: {{ section.settings.button_custom_bg }} !important;
    }
  {%- endif -%}
  {%- if section.settings.button_custom_text != blank -%}
    #PruvHero-{{ section.id }} .button--hero-primary {
      color: {{ section.settings.button_custom_text }} !important;
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.image != blank
    assign hero_image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
  endif

  assign v_align = 'end'
  assign h_align = 'start'
  assign text_align = 'left'
  case section.settings.content_position
    when 'top-left'
      assign v_align = 'start'
      assign h_align = 'start'
      assign text_align = 'left'
    when 'top-center'
      assign v_align = 'start'
      assign h_align = 'center'
      assign text_align = 'center'
    when 'top-right'
      assign v_align = 'start'
      assign h_align = 'end'
      assign text_align = 'right'
    when 'middle-left'
      assign v_align = 'center'
      assign h_align = 'start'
      assign text_align = 'left'
    when 'middle-center'
      assign v_align = 'center'
      assign h_align = 'center'
      assign text_align = 'center'
    when 'middle-right'
      assign v_align = 'center'
      assign h_align = 'end'
      assign text_align = 'right'
    when 'bottom-left'
      assign v_align = 'end'
      assign h_align = 'start'
      assign text_align = 'left'
    when 'bottom-center'
      assign v_align = 'end'
      assign h_align = 'center'
      assign text_align = 'center'
    when 'bottom-right'
      assign v_align = 'end'
      assign h_align = 'end'
      assign text_align = 'right'
  endcase

  assign show_content = section.settings.show_content
  if show_content == nil
    assign show_content = true
  endif

  assign show_button_1 = section.settings.show_button_1
  if show_button_1 == nil
    assign show_button_1 = true
  endif

  assign show_button_2 = section.settings.show_button_2
  if show_button_2 == nil
    assign show_button_2 = true
  endif
-%}

<section
  id="PruvHero-{{ section.id }}"
  class="pruv-hero pruv-hero--desk-{{ section.settings.height }} pruv-hero--mob-{{ section.settings.mobile_height }} pruv-hero--mode-{{ section.settings.position_mode | default: 'grid' }} pruv-hero--mob-pos-{{ section.settings.mobile_content_position | default: 'bottom' }} color-{{ section.settings.color_scheme }}"
>
  <div class="pruv-hero__visual">
    <div class="pruv-hero__media">
      <picture class="pruv-hero__picture">
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 375 }} 375w,
              {{ section.settings.image_mobile | image_url: width: 550 }} 550w,
              {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
              {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
          >
        {%- endif -%}

        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 3840
            | image_tag:
              width: section.settings.image.width,
              height: hero_image_height,
              sizes: '100vw',
              widths: widths,
              fetchpriority: fetch_priority,
              class: 'pruv-hero__image',
              loading: 'eager'
          }}
        {%- elsif section.settings.image_mobile != blank -%}
          {{
            section.settings.image_mobile
            | image_url: width: 1500
            | image_tag:
              sizes: '100vw',
              fetchpriority: fetch_priority,
              class: 'pruv-hero__image',
              loading: 'eager'
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'pruv-hero__image placeholder-svg' }}
        {%- endif -%}
      </picture>
    </div>

    <div class="pruv-hero__container">
      {%- if show_content -%}
        {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank or section.settings.coupon_code != blank or section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
          <div
            class="pruv-hero__content pruv-hero__content--align-{{ text_align }} pruv-hero__content--mob-align-{{ section.settings.mobile_content_alignment }}"
            style="align-self: {{ v_align }}; justify-self: {{ h_align }}; text-align: {{ text_align }}; transform: translate({{ section.settings.offset_x }}px, {{ section.settings.offset_y }}px);"
          >
            {%- if section.settings.eyebrow != blank -%}
              <p class="pruv-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h1 class="pruv-hero__heading pruv-hero__heading--{{ section.settings.heading_size }}">
                {{ section.settings.heading }}
              </h1>
            {%- endif -%}

            {%- if section.settings.subheading != blank -%}
              <div class="pruv-hero__subheading rte">{{ section.settings.subheading }}</div>
            {%- endif -%}

            {%- if section.settings.coupon_code != blank -%}
              <div class="pruv-hero__coupon-badge">
                <span class="pruv-hero__coupon-text">{{ section.settings.coupon_code | escape }}</span>
              </div>
            {%- endif -%}

            {%- if show_button_1 or show_button_2 -%}
              {%- assign hero_btn_1_style = section.settings.button_style_1 | default: 'pill-black' -%}
              {%- assign hero_btn_2_style = section.settings.button_style_2 | default: 'outline' -%}
              <div class="pruv-hero__buttons">
                {%- if show_button_1 and section.settings.button_label_1 != blank -%}
                  <a
                    {% if section.settings.button_link_1 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ section.settings.button_link_1 }}"
                    {% endif %}
                    class="button button--hero button--hero-primary button--hero-{{ hero_btn_1_style }}"
                  >
                    {{- section.settings.button_label_1 | escape -}}
                  </a>
                {%- endif -%}
                {%- if show_button_2 and section.settings.button_label_2 != blank -%}
                  <a
                    {% if section.settings.button_link_2 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ section.settings.button_link_2 }}"
                    {% endif %}
                    class="button button--hero button--hero-secondary button--hero-{{ hero_btn_2_style }}"
                  >
                    {{- section.settings.button_label_2 | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_promo_badge -%}
        <div class="pruv-hero__promo-badge pruv-hero__promo-badge--{{ section.settings.promo_badge_position }}">
          <div class="pruv-hero__promo-badge-main">
            {%- if section.settings.promo_prefix != blank -%}
              <span class="pruv-hero__promo-prefix">{{ section.settings.promo_prefix | escape }}</span>
            {%- endif -%}
            {%- if section.settings.promo_discount != blank -%}
              <span class="pruv-hero__promo-discount">{{ section.settings.promo_discount | escape }}</span>
            {%- endif -%}
            {%- if section.settings.promo_suffix != blank -%}
              <span class="pruv-hero__promo-suffix">{{ section.settings.promo_suffix | escape }}</span>
            {%- endif -%}
          </div>
          {%- if section.settings.promo_tag != blank -%}
            <div class="pruv-hero__promo-tag">
              <span>{{ section.settings.promo_tag | escape }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_bottom_bar -%}
    {%- if section.settings.bottom_bar_mode == 'ticker' and section.settings.ticker_text != blank -%}
      <div class="pruv-hero__ticker" style="--ticker-duration: {{ section.settings.ticker_speed | default: 22 }}s;">
        <div class="pruv-hero__ticker-track">
          {%- for i in (1..6) -%}
            <div class="pruv-hero__ticker-item" {% if i > 1 %}aria-hidden="true"{% endif %}>
              <span>{{ section.settings.ticker_text | escape }}</span>
              <span class="pruv-hero__ticker-separator" aria-hidden="true">•</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- elsif section.settings.bottom_bar_mode == 'press_marquee' and section.blocks.size > 0 -%}
      <div class="pruv-hero__press">
        {%- if section.settings.press_heading != blank -%}
          <p class="pruv-hero__press-eyebrow">{{ section.settings.press_heading | escape }}</p>
        {%- endif -%}
        <div class="pruv-hero__marquee">
          <div class="pruv-hero__marquee-track">
            {%- for i in (1..2) -%}
              {%- for block in section.blocks -%}
                <div class="pruv-hero__logo" {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
                  {%- if block.settings.logo != blank -%}
                    {{
                      block.settings.logo
                      | image_url: width: 300
                      | image_tag: loading: 'lazy', widths: '150, 200, 300', alt: block.settings.name | escape
                    }}
                  {%- else -%}
                    <span class="pruv-hero__logo-text">{{ block.settings.name }}</span>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Prüv hero",
  "tag": "section",
  "class": "section pruv-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop background image",
      "info": "Recommended: 2880 x 1200px or larger."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile background image",
      "info": "Optional. Recommended: 800 x 1200px. If blank, desktop image will be used."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Desktop section height",
      "options": [
        { "value": "small", "label": "Small (60vh)" },
        { "value": "medium", "label": "Medium (75vh)" },
        { "value": "large", "label": "Large (92vh)" },
        { "value": "full", "label": "Full screen (100vh)" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile section height",
      "options": [
        { "value": "small", "label": "Small (55vh)" },
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "large", "label": "Large (85vh)" },
        { "value": "full", "label": "Full screen (100vh)" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 35
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "gradient", "label": "Dark smooth gradient" },
        { "value": "subtle-bottom", "label": "Subtle bottom fade" },
        { "value": "solid", "label": "Solid dark overlay" },
        { "value": "light-gradient", "label": "Light soft gradient" }
      ],
      "default": "gradient"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Placement & Positioning"
    },
    {
      "type": "select",
      "id": "position_mode",
      "label": "Positioning mode",
      "options": [
        { "value": "grid", "label": "Standard Grid Anchors" },
        { "value": "canvas", "label": "Freeform Canvas Coordinates (X/Y %)" }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Freeform Canvas Controls"
    },
    {
      "type": "range",
      "id": "canvas_pos_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Desktop X Position (Left to Right)",
      "default": 15,
      "info": "0% = Left edge, 50% = Center, 100% = Right edge"
    },
    {
      "type": "range",
      "id": "canvas_pos_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Desktop Y Position (Top to Bottom)",
      "default": 75,
      "info": "0% = Top edge, 50% = Middle, 100% = Bottom edge"
    },
    {
      "type": "range",
      "id": "canvas_max_width",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Desktop Content Box Max Width",
      "default": 640
    },
    {
      "type": "range",
      "id": "mobile_canvas_pos_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mobile X Position (Left to Right)",
      "default": 50,
      "info": "Active in Canvas Mode"
    },
    {
      "type": "range",
      "id": "mobile_canvas_pos_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mobile Y Position (Top to Bottom)",
      "default": 85,
      "info": "Active in Canvas Mode"
    },
    {
      "type": "range",
      "id": "mobile_canvas_max_width",
      "min": 240,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Mobile Content Box Max Width",
      "default": 420
    },
    {
      "type": "header",
      "content": "Standard Grid Anchor Settings"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Desktop content anchor",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Mobile vertical placement (Grid mode)",
      "options": [
        { "value": "bottom", "label": "Bottom of image" },
        { "value": "middle", "label": "Middle of image" },
        { "value": "top", "label": "Top of image" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "label": "Mobile text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "offset_x",
      "min": -150,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Nudge horizontally (Desktop Grid)",
      "default": 0
    },
    {
      "type": "range",
      "id": "offset_y",
      "min": -150,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Nudge vertically (Desktop Grid)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography & Text Content"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show text & button content",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Tagline",
      "default": "Payday Sale is LIVE!"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grab your essentials"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra Large" }
      ],
      "default": "large"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Scalp-focused hair rituals engineered for the water, pollution and buildup your city actually throws at your hair.</p>"
    },
    {
      "type": "text",
      "id": "coupon_code",
      "label": "Coupon code text",
      "default": "Use code: PAYDAY",
      "info": "Leave blank to hide coupon code badge"
    },
    {
      "type": "header",
      "content": "Buttons & CTA"
    },
    {
      "type": "checkbox",
      "id": "show_button_1",
      "label": "Show primary button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },
    {
      "type": "select",
      "id": "button_style_1",
      "label": "First button style",
      "options": [
        { "value": "pill-black", "label": "Pill Black (Sleek Graphite)" },
        { "value": "pill-primary", "label": "Pill Accent / Blue" },
        { "value": "pill-white", "label": "Pill White" },
        { "value": "solid-primary", "label": "Solid Primary" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "pill-black"
    },
    {
      "type": "color",
      "id": "button_custom_bg",
      "label": "Custom button background color",
      "info": "Optional override (e.g. choose your preferred shade of dark/color)"
    },
    {
      "type": "color",
      "id": "button_custom_text",
      "label": "Custom button text color",
      "info": "Optional override"
    },
    {
      "type": "checkbox",
      "id": "show_button_2",
      "label": "Show secondary button",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "View rituals"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "Second button style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "pill-white", "label": "Pill White" },
        { "value": "pill-black", "label": "Pill Black" },
        { "value": "solid-secondary", "label": "Solid Secondary" }
      ],
      "default": "outline"
    },
    {
      "type": "header",
      "content": "Promotional Offer Graphic / Badge"
    },
    {
      "type": "checkbox",
      "id": "show_promo_badge",
      "label": "Show promotional offer graphic",
      "default": false,
      "info": "Displays a prominent sale/discount graphic like 'FLAT 25% OFF'"
    },
    {
      "type": "text",
      "id": "promo_prefix",
      "label": "Promo prefix text",
      "default": "FLAT"
    },
    {
      "type": "text",
      "id": "promo_discount",
      "label": "Promo discount number",
      "default": "25%"
    },
    {
      "type": "text",
      "id": "promo_suffix",
      "label": "Promo suffix text",
      "default": "OFF"
    },
    {
      "type": "text",
      "id": "promo_tag",
      "label": "Promo coupon pill tag",
      "default": "USE CODE | PAYDAY"
    },
    {
      "type": "select",
      "id": "promo_badge_position",
      "label": "Promo badge position",
      "options": [
        { "value": "right", "label": "Right side (Desktop)" },
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left side / inline" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Bottom Strip / Marquee"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_bar",
      "label": "Show bottom banner bar",
      "default": true
    },
    {
      "type": "select",
      "id": "bottom_bar_mode",
      "label": "Bottom bar type",
      "options": [
        { "value": "ticker", "label": "Promotional Ticker (Sale / Announcement)" },
        { "value": "press_marquee", "label": "Press logos marquee" }
      ],
      "default": "press_marquee"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker announcement text",
