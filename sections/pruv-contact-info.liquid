          "settings": {
            "label": "EMAIL",
            "line_1": "hello@pruv.in",
            "link": "mailto:hello@pruv.in",
            "line_2": "We reply within 24 hours"
          }
        },
        {
          "type": "contact_card",
          "settings": {
            "label": "CHAT",
            "line_1": "WhatsApp us",
            "link": "https://wa.me/919876543210",
            "line_2": "Fastest way to reach the team",
            "line_3": "Order help, routine advice"
          }
        },
        {
          "type": "contact_card",
          "settings": {
            "label": "HEADQUARTERS",
            "line_1": "Prüv Labs",
            "line_2": "212 Okhla Industrial Estate, Phase III",
            "line_3": "New Delhi 110020, India"
          }
        },
        {
          "type": "contact_card",
          "settings": {
            "label": "CAREERS",
            "line_1": "careers@pruv.in",
