{{ 'section-pruv-trishield.css' | asset_url | stylesheet_tag }}
<section class="pruv-ts">
  <div class="page-width">
    <div class="pruv-ts__head">
      {%- if section.settings.eyebrow != blank -%}<p class="pruv-ts__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="pruv-ts__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="pruv-ts__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </div>
    <div class="pruv-ts__grid">
      {%- for block in section.blocks -%}
        <div class="pruv-ts__card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prüv concerns",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why hair can feel coated" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "When hair feels weighed down" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Everyday buildup can leave hair feeling rough, dull and heavy." }
  ],
  "blocks": [
    { "type": "card", "name": "Concern card", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Rough" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Hair can feel coarse when residue sits on the surface." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Prüv concerns", "blocks": [
    { "type": "card", "settings": { "title": "Rough", "text": "Hair can feel coarse when residue sits on the surface." } },
    { "type": "card", "settings": { "title": "Dull", "text": "Buildup can make hair look flat and lacklustre." } },
    { "type": "card", "settings": { "title": "Weighed down", "text": "Product, oil and everyday residue can leave hair feeling heavy." } }
  ] }]
}
{% endschema %}
