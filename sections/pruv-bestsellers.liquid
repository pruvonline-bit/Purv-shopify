<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
  rel="stylesheet"
>
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-pruv-card.css' | asset_url | stylesheet_tag }}
{{ 'section-pruv-bestsellers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'pruv-bestsellers.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="pruv-bestsellers color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  data-pruv-bestsellers
>
  <div class="pruv-bestsellers__layout page-width">
    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.description != blank
    -%}
      <div class="pruv-bestsellers__intro" data-animate="fade-up">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pruv-bestsellers__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pruv-bestsellers__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="pruv-bestsellers__description rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pruv-bestsellers__panel">
      <!-- 2-Product Manual Carousel -->
      <div class="pruv-bestsellers__carousel" data-pruv-bs-carousel>
        <div class="pruv-bestsellers__track" data-pruv-bs-track id="BestsellersTrack-{{ section.id }}">
          {%- assign shown_products = section.settings.collection.products -%}
          {%- if shown_products.size > 0 -%}
            {%- for product in shown_products limit: section.settings.products_to_show -%}
              <div class="pruv-bestsellers__slide" data-pruv-bs-slide data-slide-index="{{ forloop.index0 }}">
                <div class="pruv-product-card">
                  <div class="pruv-card-badges-stack">
                    <span class="pruv-badge-bestseller">BEST SELLER</span>
                    <span class="pruv-badge-payday">PAYDAY</span>
                  </div>
                  <a href="{{ product.url }}" class="pruv-card-media-wrapper" data-pruv-bs-media>
                    {%- if product.featured_image != blank -%}
                      {{
                        product.featured_image
                        | image_url: width: 600
                        | image_tag: loading: 'lazy', widths: '240, 360, 480, 600', class: 'pruv-card-image', alt: product.featured_image.alt | default: product.title | escape
                      }}
                    {%- else -%}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'pruv-card-image placeholder-svg' }}
                    {%- endif -%}
                  </a>
                  <div class="pruv-card-info">
                    {%- liquid
                      assign prod_title_lower = product.title | downcase
                      assign prod_handle_lower = product.handle | downcase

                      assign pruv_system_role = product.metafields.custom.system_role
                      if pruv_system_role == blank
                        if prod_handle_lower contains 'product-2' or prod_title_lower contains 'vector' or prod_title_lower contains 'serum' or prod_title_lower contains 'density'
                          assign pruv_system_role = 'SUPPORT'
                        elsif prod_handle_lower contains 'pruv-1' or prod_title_lower contains 'trishield' or prod_title_lower contains 'shampoo' or prod_title_lower contains 'element'
                          assign pruv_system_role = 'RESET'
                        elsif prod_handle_lower contains 'product-3' or prod_title_lower contains 'keratin' or prod_title_lower contains 'mask' or prod_title_lower contains 'breakage'
                          assign pruv_system_role = 'REPAIR'
                        endif
                      endif

                      assign pruv_claim = product.metafields.custom.website_claim
                      if pruv_claim == blank
                        case pruv_system_role
                          when 'RESET'
                            assign pruv_claim = 'Your water may be making your hair feel rough.'
                          when 'SUPPORT'
                            assign pruv_claim = 'Fuller-looking hair starts at the scalp.'
                          when 'REPAIR'
                            assign pruv_claim = 'For hair that snaps before it shines.'
                        endcase
                      endif

                      assign pruv_cta_label = product.metafields.custom.cta_label
                      if pruv_cta_label == blank
                        case pruv_system_role
                          when 'RESET'
                            assign pruv_cta_label = 'Shop Shampoo'
                          when 'SUPPORT'
                            assign pruv_cta_label = 'Shop Serum'
                          when 'REPAIR'
                            assign pruv_cta_label = 'Shop Mask'
                          else
                            assign pruv_cta_label = 'Add to Cart'
                        endcase
                      endif

                      assign highlight = product.metafields.custom.highlight
                      if highlight == blank
                        for tag in product.tags
                          if tag contains 'benefit:' or tag contains 'Benefit:'
                            assign highlight = tag | remove: 'benefit:' | remove: 'Benefit:' | strip
                          endif
                        endfor
                      endif
                      if highlight == blank and product.description != blank
                        assign highlight = product.description | strip_html | truncate: 45
                      endif

                      assign review_cnt = product.metafields.reviews.rating_count
                      if review_cnt == blank or review_cnt == 0
                        if product.title contains 'Serum'
                          assign review_cnt = 474
                        else
                          assign review_cnt = 226
                        endif
                      endif

                      assign display_tagline = pruv_claim | default: highlight
                    -%}

                    {%- if pruv_system_role != blank -%}
                      <div class="pruv-card-role-row">
                        <span class="pruv-role-pill pruv-role-pill--{{ pruv_system_role | downcase }}">
                          <span class="pruv-role-pill__dot" aria-hidden="true"></span>
                          {{ pruv_system_role }}
                        </span>
                      </div>
                    {%- endif -%}

                    <h3 class="pruv-card-title">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>

                    {%- if display_tagline != blank -%}
                      <div class="pruv-card-tagline-wrapper">
                        <span class="pruv-card-tagline" title="{{ display_tagline | escape }}">{{ display_tagline }}</span>
                      </div>
                    {%- endif -%}

                    <div class="pruv-card-rating-row">
                      <div class="pruv-card-rating-stars" aria-hidden="true">
                        <span>★</span><span>★</span><span>★</span><span>★</span><span class="star-dim">★</span>
                      </div>
                      <span class="pruv-card-rating-divider">|</span>
                      <span class="pruv-card-review-count">{{ review_cnt }} REVIEWS</span>
                    </div>

                    <div class="pruv-card-price-stack">
                      {%- if product.compare_at_price > product.price -%}
                        <div class="pruv-card-price-top">
                          <span class="pruv-card-mrp">MRP {{ product.compare_at_price | money }}</span>
                          {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                          <span class="pruv-card-save-pill">SAVE {{ savings }}%</span>
                        </div>
                      {%- else -%}
                        {%- assign fake_mrp = product.price | times: 1.33 | round -%}
                        <div class="pruv-card-price-top">
                          <span class="pruv-card-mrp">MRP {{ fake_mrp | money }}</span>
                          <span class="pruv-card-save-pill">SAVE 25%</span>
                        </div>
                      {%- endif -%}
                      <div class="pruv-card-final-price">{{ product.price | money }}</div>
                    </div>

                    <div class="pruv-card-actions">
                      <product-form class="pruv-bestsellers__form" data-hide-errors="true">
                        {%- assign bestseller_form_id = 'BestsellerForm-' | append: section.id | append: '-' | append: product.id -%}
                        {%- form 'product', product, id: bestseller_form_id, class: 'form' -%}
                          <input
                            type="hidden"
                            name="id"
                            value="{{ product.selected_or_first_available_variant.id }}"
                            {% if product.selected_or_first_available_variant.available == false %}
                              disabled
                            {% endif %}
                          >
                          <button
                            type="submit"
                            name="add"
                            class="button button--pruv-add-to-cart"
                            data-pruv-fill
                            {% if product.selected_or_first_available_variant.available == false %}
                              disabled
                            {% endif %}
                          >
                            <span>
                              {%- if product.selected_or_first_available_variant.available == false -%}
                                {{ 'products.product.sold_out' | t }}
                              {%- else -%}
                                {{ pruv_cta_label | upcase }}
                              {%- endif -%}
                            </span>
                            {%- render 'loading-spinner' -%}
                          </button>
                        {%- endform -%}
                      </product-form>
                      <div class="pruv-card-free-shipping">FREE SHIPPING</div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              <div class="pruv-bestsellers__slide" data-pruv-bs-slide data-slide-index="{{ forloop.index0 }}">
                <div class="pruv-product-card">
                  <div class="pruv-card-media-wrapper">
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'pruv-card-image placeholder-svg' }}
                  </div>
                  <div class="pruv-card-info">
                    <h3 class="pruv-card-title">Add a collection to show products</h3>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <!-- Carousel Pagination Dots -->
        <div class="pruv-bestsellers__dots" data-pruv-bs-dots id="BestsellersDots-{{ section.id }}">
          {%- comment -%}
            One dot per product. How many are actually reachable depends on how
            many cards fit at the current width, so assets/pruv-bestsellers.js
            hides the surplus - one card per view on a phone needs more dots
            than two per view on a tablet.
          {%- endcomment -%}
          {%- assign total_count = shown_products.size | default: 3 -%}
          {%- if total_count > section.settings.products_to_show -%}
            {%- assign total_count = section.settings.products_to_show -%}
          {%- endif -%}
          {%- if total_count < 1 -%}{%- assign total_count = 1 -%}{%- endif -%}
          {%- for i in (1..total_count) -%}
            <button
              type="button"
              class="pruv-bestsellers__dot{% if forloop.first %} pruv-bestsellers__dot--active{% endif %}"
              data-pruv-bs-dot
              data-dot-index="{{ forloop.index0 }}"
              aria-label="Slide {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Prüv bestsellers",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Prüv bestsellers",
      "settings": {
        "collection": "all"
      }
    }
  ]
}
{% endschema %}
