{{ 'section-pruv-vivine.css' | asset_url | stylesheet_tag }}

<section
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  class="pruv-vivine pruv-vivine-why{% if section.settings.dark %} pruv-vivine--dark{% endif %} section-{{ section.id }}-padding"
>
  <div class="page-width">
    {%- render 'pruv-vivine-header' -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pruv-vivine-why__grid" data-animate="stagger">
        {%- for block in section.blocks -%}
          <div class="pruv-vivine-why__item" {{ block.shopify_attributes }}>
            <span class="pruv-vivine__icon">{%- render 'pruv-vivine-icon', icon: block.settings.icon -%}</span>
            <h3 class="pruv-vivine-why__title">{{ block.settings.title | escape }}</h3>
            <p class="pruv-vivine-why__text">{{ block.settings.text | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "VivinePro benefits",
  "tag": "section",
  "class": "section pruv-vivine-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Optional. Lets buttons link to this section."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why you need it"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Why your scalp needs <strong>Vector-5</strong>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Dark background",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "sprout",
          "options": [
            { "value": "sprout", "label": "Sprout / growth" },
            { "value": "shield", "label": "Shield / protection" },
            { "value": "drop", "label": "Drop" },
            { "value": "bolt", "label": "Energy" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "clock", "label": "Clock" },
            { "value": "flask", "label": "Lab flask" },
            { "value": "target", "label": "Target" },
            { "value": "dna", "label": "DNA" },
            { "value": "water", "label": "Water" },
            { "value": "spark", "label": "Spark" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Boosts hair growth"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "[Placeholder] One or two lines explaining the benefit."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "VivinePro benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "sprout", "title": "Boosts hair growth" } },
        { "type": "benefit", "settings": { "icon": "shield", "title": "Reduces hair fall" } },
        { "type": "benefit", "settings": { "icon": "bolt", "title": "Energises follicles" } },
        { "type": "benefit", "settings": { "icon": "leaf", "title": "Calms the scalp" } }
      ]
    }
  ]
}
{% endschema %}
