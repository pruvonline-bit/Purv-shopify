{{ 'section-pruv-ritual-explainer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  The scroll-through: .pruv-ritual__scroll is a tall spacer whose height grows
  with the step count, and .pruv-ritual__stage sticks inside it. Scroll
  progress through the spacer selects the active step - see
  assets/pruv-ritual-explainer.js. With JS or GSAP absent the spacer collapses
  to auto height and every step renders open (see the .pruv-ritual--live
  guard in the stylesheet), so the section degrades to a readable list.
{%- endcomment -%}

<section
  class="pruv-ritual color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  data-pruv-ritual
>
  <div class="pruv-ritual__scroll" data-pruv-ritual-scroll style="--pruv-ritual-steps: {{ section.blocks.size }}">
    <div class="pruv-ritual__stage" data-pruv-ritual-stage>
      <div class="pruv-ritual__container">
        {%- if section.settings.eyebrow != blank
          or section.settings.heading != blank
          or section.settings.subheading != blank
        -%}
          <div class="pruv-ritual__header">
            {%- if section.settings.eyebrow != blank -%}
              <p class="pruv-ritual__eyebrow">
                <span class="pruv-ritual__eyebrow-dot" aria-hidden="true"></span>
                {{ section.settings.eyebrow | escape }}
              </p>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2 class="pruv-ritual__heading">{{ section.settings.heading }}</h2>
            {%- endif -%}

            {%- if section.settings.subheading != blank -%}
              <div class="pruv-ritual__subheading">{{ section.settings.subheading }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <ol class="pruv-ritual__steps" data-pruv-ritual-steps>
          {%- comment -%}
            One continuous rail behind the rows; the fill and marker are moved
            to the active row's node by JS.
          {%- endcomment -%}
          {%- if section.settings.show_connectors and section.blocks.size > 1 -%}
            <span class="pruv-ritual__rail" aria-hidden="true">
              <span class="pruv-ritual__rail-track"></span>
              <span class="pruv-ritual__rail-fill" data-pruv-ritual-fill></span>
              <span class="pruv-ritual__rail-marker" data-pruv-ritual-marker></span>
            </span>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- liquid
              assign step_display_num = block.settings.step_number | default: forloop.index
              assign viz = block.settings.viz
              if viz == 'auto' or viz == blank
                case forloop.index
                  when 1
                    assign viz = 'reset'
                  when 2
                    assign viz = 'support'
                  when 3
                    assign viz = 'repair'
                  else
                    assign viz = 'none'
                endcase
              endif
              assign panel_id = 'PruvRitualPanel-' | append: section.id | append: '-' | append: forloop.index
            -%}
            <li
              class="pruv-ritual__step{% if forloop.first %} is-active{% endif %}"
              data-pruv-ritual-step
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <button
                class="pruv-ritual__step-head"
                type="button"
                data-pruv-ritual-trigger
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="{{ panel_id }}"
              >
                <span class="pruv-ritual__step-index">
                  {{- step_display_num | prepend: '0' | slice: -2, 2 -}}
                </span>
                <span class="pruv-ritual__step-node" data-pruv-ritual-node aria-hidden="true"></span>
                <span class="pruv-ritual__step-title">{{ block.settings.title | escape }}</span>
              </button>

              <div class="pruv-ritual__step-panel" id="{{ panel_id }}" data-pruv-ritual-panel>
                <div class="pruv-ritual__step-inner">
                  <div class="pruv-ritual__step-copy">
                    {%- if block.settings.tagline != blank -%}
                      <p class="pruv-ritual__step-tagline">{{ block.settings.tagline | escape }}</p>
                    {%- endif -%}

                    {%- if block.settings.description != blank -%}
                      <p class="pruv-ritual__step-description">{{ block.settings.description | escape }}</p>
                    {%- endif -%}

                    {%- if block.settings.product_role != blank -%}
                      <p class="pruv-ritual__step-product">{{ block.settings.product_role | escape }}</p>
                    {%- endif -%}

                    {%- if block.settings.key_actives != blank -%}
                      <div class="pruv-ritual__actives">
                        <span class="pruv-ritual__actives-label">{{ 'Key actives' }}</span>
                        <span class="pruv-ritual__actives-text">{{ block.settings.key_actives | escape }}</span>
                      </div>
                    {%- endif -%}
                  </div>

                  {%- comment -%}
                    Custom media wins over the built-in diagram, in order:
                    uploaded video, then a raw file (animated WebP/SVG/GIF
                    served untransformed), then an image, else the SVG.
                  {%- endcomment -%}
                  {%- liquid
                    assign media_src = ''
                    if block.settings.media_file != blank
                      if block.settings.media_file contains '//'
                        assign media_src = block.settings.media_file
                      else
                        assign media_src = block.settings.media_file | file_url
                      endif
                    endif
                  -%}

                  {%- if block.settings.video != blank -%}
                    <div class="pruv-ritual__step-viz pruv-ritual__step-viz--media" aria-hidden="true">
                      {%- comment -%}
                        Hand-rolled rather than video_tag: inline autoplay on
                        iOS needs both `muted` and `playsinline`, and
                        video_tag does not take a playsinline argument.
                      {%- endcomment -%}
                      <video
                        autoplay
                        loop
                        muted
                        playsinline
                        preload="metadata"
                        {% if block.settings.video.preview_image %}
                          poster="{{ block.settings.video.preview_image | image_url: width: 900 }}"
                        {% endif %}
                      >
                        {%- for source in block.settings.video.sources -%}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endfor -%}
                      </video>
                    </div>
                  {%- elsif media_src != blank -%}
                    <div class="pruv-ritual__step-viz pruv-ritual__step-viz--media">
                      {%- comment -%}
                        file_url serves the original bytes, so animation in a
                        WebP/SVG/GIF survives - the image CDN can re-encode an
                        animated file down to a single frame.
                      {%- endcomment -%}
                      <img src="{{ media_src }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                    </div>
                  {%- elsif block.settings.image != blank -%}
                    <div class="pruv-ritual__step-viz pruv-ritual__step-viz--media">
                      <img
                        src="{{ block.settings.image | image_url: width: block.settings.image.width }}"
                        alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        loading="lazy"
                      >
                    </div>
                  {%- elsif viz != 'none' -%}
                    <div class="pruv-ritual__step-viz" aria-hidden="true">
                      {%- render 'pruv-ritual-viz', viz: viz -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prüv Ritual Explainer",
  "tag": "section",
  "class": "section pruv-ritual-explainer-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Learn in Seconds: <em>Reset. Support. Repair.</em>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "show_connectors",
      "label": "Show the progress rail",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Ritual Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step number (e.g. 1, 2, 3)",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "RESET"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Step Subtitle / Phase",
          "default": "Phase 01 · Scalp Detox & Demineralisation"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "10-Second Takeaway / Role Description",
          "default": "Dissolves stubborn calcium, magnesium and mineral salts left by municipal hard water. Clears congested follicular pores without drying out scalp lipids."
        },
        {
          "type": "text",
          "id": "product_role",
          "label": "Product Role",
          "default": "TriShield Clarifying Shampoo"
        },
        {
          "type": "text",
          "id": "key_actives",
          "label": "Key Actives",
          "default": "Tetrasodium EDTA · Salicylic Acid · Botanical Chelators"
        },
        {
          "type": "header",
          "content": "Step visual"
        },
        {
          "type": "paragraph",
          "content": "Upload your own to replace the built-in diagram. Order used: video, then file name, then image. MP4 belongs in the video slot. Animated WebP, SVG or GIF belongs in the file name slot, because the image slot can flatten animation to one frame."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video — MP4 / WebM",
          "info": "Plays inline, muted, on loop."
        },
        {
          "type": "text",
          "id": "media_file",
          "label": "Animated file name",
          "info": "For animated WebP, SVG or GIF. Upload it under Content → Files, then enter the file name here, e.g. reset-loop.webp. A full URL also works."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Still image"
        },
        {
          "type": "select",
          "id": "viz",
          "label": "Built-in animated diagram",
          "info": "Used only when no video or image is set. Auto picks by position: 1st Reset, 2nd Support, 3rd Repair.",
          "options": [
            { "value": "auto", "label": "Auto" },
            { "value": "reset", "label": "Reset — mineral crust dissolving" },
            { "value": "support", "label": "Support — nutrients into follicle" },
            { "value": "repair", "label": "Repair — cuticle sealing" },
            { "value": "none", "label": "None" }
          ],
          "default": "auto"
        },
        {
          "type": "header",
          "content": "Unused"
        },
        {
          "type": "paragraph",
          "content": "The time badge and per-step button are kept so existing content is not lost, but the redesigned section does not render them."
        },
        {
          "type": "text",
          "id": "time_badge",
          "label": "Time / Frequency badge (not shown)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label (not shown)"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link (not shown)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Prüv Ritual Explainer",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "1",
            "title": "RESET",
            "tagline": "Phase 01 · Scalp Detox & Demineralisation",
            "product_role": "TriShield Clarifying Shampoo",
            "description": "Dissolves stubborn calcium, magnesium and mineral crusts deposited by city hard water. Decongests follicular pores without stripping natural barrier lipids.",
            "key_actives": "Tetrasodium EDTA · Salicylic Acid · Botanical Chelators",
            "viz": "auto"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "2",
            "title": "SUPPORT",
            "tagline": "Phase 02 · Microbiome & Follicle Nutrition",
            "product_role": "Follicle Tonic & Daily Conditioner",
            "description": "Rebalances scalp pH, nourishes the microbial ecosystem, and floods the root zone with essential micronutrients to boost microcirculation.",
            "key_actives": "Probiotic Ferments · Niacinamide · Rosemary Peptides",
            "viz": "auto"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "3",
            "title": "REPAIR",
            "tagline": "Phase 03 · Bond Integrity & Cuticle Shield",
            "product_role": "Keratin & Ceramide Deep Recovery Mask",
            "description": "Reconstructs damaged keratin chains, seals lifted hair cuticles against humidity, and leaves a breathable shield against urban micro-pollutants.",
            "key_actives": "Hydrolyzed Keratin · Ceramide NP · Argan Lipid Matrix",
            "viz": "auto"
          }
        }
      ]
    }
  ]
}
{% endschema %}
