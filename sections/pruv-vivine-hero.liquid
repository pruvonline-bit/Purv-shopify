{{ 'section-pruv-vivine.css' | asset_url | stylesheet_tag }}

{%- assign hero_product = section.settings.product -%}

<section class="pruv-vivine pruv-vivine-hero{% if section.settings.dark %} pruv-vivine--dark{% endif %} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="pruv-vivine-hero__grid">
      <div class="pruv-vivine-hero__content" data-animate="from-left">
        {%- render 'pruv-vivine-header' -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="pruv-vivine-hero__claims">
            {%- for block in section.blocks -%}
              <li class="pruv-vivine-hero__claim" {{ block.shopify_attributes }}>
                <span class="pruv-vivine__icon">{%- render 'pruv-vivine-icon', icon: block.settings.icon -%}</span>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="pruv-vivine-hero__actions">
          {%- if hero_product != blank and section.settings.button_label != blank -%}
            <a href="{{ hero_product.url }}" class="pruv-vivine__btn">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a href="#{{ section.settings.secondary_anchor | default: 'science' | handleize }}" class="pruv-vivine__btn pruv-vivine__btn--ghost">
              {{- section.settings.secondary_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="pruv-vivine-hero__media" data-animate="from-right">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 45vw, 100vw'
          }}
        {%- elsif hero_product.featured_media != blank -%}
          {{
            hero_product.featured_media
            | image_url: width: 1400
            | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 45vw, 100vw', alt: hero_product.title
          }}
        {%- else -%}
          <span class="pruv-vivine-hero__media-placeholder">Hair VivinePro™</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "VivinePro hero",
  "tag": "section",
  "class": "section pruv-vivine-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The science behind Vector-5"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Breakthrough hair growth, powered by <strong>Hair VivinePro™</strong>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>[Placeholder] One-line description of what Hair VivinePro is and why it is different. Replace with approved claim copy.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Falls back to the selected product's main image."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Hero product",
      "info": "The Vector-5 serum. The main button links to it."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Main button label",
      "default": "Shop the serum"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "See the science"
    },
    {
      "type": "text",
      "id": "secondary_anchor",
      "label": "Secondary button scrolls to section anchor",
      "default": "science",
      "info": "Must match the 'Anchor ID' of another section on this page."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Dark background",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "claim",
      "name": "Claim",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "sprout",
          "options": [
            { "value": "sprout", "label": "Sprout / growth" },
            { "value": "shield", "label": "Shield / protection" },
            { "value": "drop", "label": "Drop" },
            { "value": "bolt", "label": "Energy" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "clock", "label": "Clock" },
            { "value": "flask", "label": "Lab flask" },
            { "value": "target", "label": "Target" },
            { "value": "dna", "label": "DNA" },
            { "value": "water", "label": "Water" },
            { "value": "spark", "label": "Spark" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Visible growth in XX days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VivinePro hero",
      "blocks": [
        { "type": "claim", "settings": { "icon": "sprout", "text": "Visible growth in XX days" } },
        { "type": "claim", "settings": { "icon": "shield", "text": "Up to XX% less hair fall" } }
      ]
    }
  ]
}
{% endschema %}
