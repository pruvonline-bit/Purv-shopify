{{ 'section-pruv-usage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pruv-usage.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="pruv-usage color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <!-- Header -->
    <div class="pruv-usage__header" data-usage-header>
      {%- if section.settings.eyebrow != blank -%}
        <p class="pruv-usage__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pruv-usage__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pruv-usage__subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <!-- Bento Grid Container -->
    <div class="pruv-usage__bento">
      <!-- Bento Tile 1: How Much to Use (Span 7) -->
      <div class="pruv-usage__tile pruv-usage__tile--dose" data-usage-tile>
        <div class="pruv-usage__tile-top">
          <span class="pruv-usage__tile-badge">DOSAGE SPECIFICATION</span>
          <div class="pruv-usage__tile-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v6M9 8h6M10 8v8a2 2 0 0 0 4 0V8M9 22h6"/>
            </svg>
          </div>
        </div>

        <h3 class="pruv-usage__tile-title">How Much To Use</h3>
        <p class="pruv-usage__tile-summary">One full pipette delivers the scientifically balanced concentration of bio-actives required per application.</p>

        <div class="pruv-usage__dose-meter">
          <div class="pruv-usage__dose-pipette" aria-hidden="true">
            <div class="pruv-usage__dose-fill"></div>
          </div>
          <div class="pruv-usage__dose-meta">
            <p class="pruv-usage__dose-stat">1 Full Dropper <span>(~1.0 mL)</span></p>
            <p class="pruv-usage__dose-desc">Squeeze pipette once until fully charged. Distribute 4–6 targeted drops evenly across thinning or priority zones.</p>
          </div>
        </div>
      </div>

      <!-- Bento Tile 2: AM/PM Timing Clarity (Span 5) -->
      <div class="pruv-usage__tile pruv-usage__tile--timing" data-usage-tile>
        <div class="pruv-usage__tile-top">
          <span class="pruv-usage__tile-badge">APPLICATION TIMING</span>
          <div class="pruv-usage__tile-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
            </svg>
          </div>
        </div>

        <h3 class="pruv-usage__tile-title">AM / PM Clarity</h3>
        <p class="pruv-usage__tile-summary">Engineered to integrate seamlessly with your schedule. Non-sticky, fast-absorbing water base leaves zero residue.</p>

        <div class="pruv-usage__timing-split">
          <div class="pruv-usage__timing-card pruv-usage__timing-card--primary">
            <div class="pruv-usage__timing-badge">RECOMMENDED</div>
            <p class="pruv-usage__timing-name">PM Nighttime</p>
            <p class="pruv-usage__timing-note">Absorbs undisturbed during the scalp's natural overnight repair cycle.</p>
          </div>
          <div class="pruv-usage__timing-card">
            <div class="pruv-usage__timing-badge">ALTERNATIVE</div>
            <p class="pruv-usage__timing-name">AM Morning</p>
            <p class="pruv-usage__timing-note">Dry/damp scalp after shower. Dries in 60s without altering hair volume.</p>
          </div>
        </div>
      </div>

      <!-- Bento Tile 3: Frequency & Cadence (Span 5) -->
      <div class="pruv-usage__tile pruv-usage__tile--freq" data-usage-tile>
        <div class="pruv-usage__tile-top">
          <span class="pruv-usage__tile-badge">FREQUENCY</span>
          <div class="pruv-usage__tile-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
        </div>

        <h3 class="pruv-usage__tile-title">Daily Cadence</h3>
        <p class="pruv-usage__tile-summary">Hair follicle renewal operates on cellular rhythm. Daily consistency compounds biological results.</p>

        <div class="pruv-usage__freq-pills">
          <div class="pruv-usage__freq-pill pruv-usage__freq-pill--active">
            <span class="pruv-usage__freq-pill-title">1× Daily</span>
            <span class="pruv-usage__freq-pill-sub">Standard Routine</span>
          </div>
          <div class="pruv-usage__freq-pill">
            <span class="pruv-usage__freq-pill-title">90 Days</span>
            <span class="pruv-usage__freq-pill-sub">Continuous Cycle</span>
          </div>
        </div>
      </div>

      <!-- Bento Tile 4: Where to Apply (Span 7) -->
      <div class="pruv-usage__tile pruv-usage__tile--where" data-usage-tile>
        <div class="pruv-usage__tile-top">
          <span class="pruv-usage__tile-badge">TARGET ZONES</span>
          <div class="pruv-usage__tile-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2"/>
            </svg>
          </div>
        </div>

        <h3 class="pruv-usage__tile-title">Where To Apply</h3>
        <p class="pruv-usage__tile-summary">Deliver directly onto the scalp tissue and follicle roots. Avoid dispensing on hair shafts or ends.</p>

        <div class="pruv-usage__zones-grid">
          <div class="pruv-usage__zone-item">
            <span class="pruv-usage__zone-bullet"></span>
            <span class="pruv-usage__zone-label">Parting Lines & Central Divide</span>
          </div>
          <div class="pruv-usage__zone-item">
            <span class="pruv-usage__zone-bullet"></span>
            <span class="pruv-usage__zone-label">Receding Hairline & Temples</span>
          </div>
          <div class="pruv-usage__zone-item">
            <span class="pruv-usage__zone-bullet"></span>
            <span class="pruv-usage__zone-label">Crown & Vertex Thinning Area</span>
          </div>
          <div class="pruv-usage__zone-item">
            <span class="pruv-usage__zone-bullet"></span>
            <span class="pruv-usage__zone-label">Post-Partum / Diffuse Spots</span>
          </div>
        </div>

        <div class="pruv-usage__where-warning">
          <span>💡</span>
          <span>Pro Tip: Part hair into sections so droplets touch the scalp directly, not the hair strands.</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prüv Product Usage",
  "tag": "section",
  "class": "section pruv-usage-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE DAILY PROTOCOL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How To Use For Peak Results"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A non-greasy, water-based ritual designed for effortless daily adherence. No rinsing required."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Prüv Product Usage"
    }
  ]
}
{% endschema %}
