<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500;600&family=Instrument+Serif:ital@1&display=swap"
  rel="stylesheet"
>
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'section-pruv-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_social_icons = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_snapchat_link != blank or settings.social_tumblr_link != blank or settings.social_vimeo_link != blank
    assign has_social_icons = true
  endif
-%}

{%- liquid
  assign invert_logo = section.settings.invert_logo_for_dark
  if invert_logo == nil
    assign invert_logo = true
  endif
-%}

<footer class="pruv-footer color-{{ section.settings.color_scheme }}{% if invert_logo %} pruv-footer--invert-logo{% endif %}">
  <div class="pruv-footer__inner page-width">
    {%- comment -%} 1. Oversized newsletter call to action {%- endcomment -%}
    {%- if section.settings.newsletter_enable -%}
      <div class="pruv-footer__cta">
        <div class="pruv-footer__cta-copy">
          {%- if section.settings.newsletter_eyebrow != blank -%}
            <p class="pruv-footer__eyebrow">
              <span class="pruv-footer__eyebrow-dot" aria-hidden="true"></span>
              {{- section.settings.newsletter_eyebrow | escape -}}
            </p>
          {%- endif -%}
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="pruv-footer__headline">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}
        </div>

        <div class="pruv-footer__cta-form">
          {%- form 'customer', id: 'PruvFooterNewsletter', class: 'pruv-footer__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">Your email address</label>
            <div class="pruv-footer__field">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="pruv-footer__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="PruvFooterNewsletter-error"
                {% elsif form.posted_successfully? %}
                  aria-describedby="PruvFooterNewsletter-success"
                {% endif %}
                placeholder="Your email address"
                required
              >
              <button type="submit" class="pruv-footer__submit" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
            {%- if form.errors -%}
              <p class="pruv-footer__form-message pruv-footer__form-message--error" id="PruvFooterNewsletter-error">
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="pruv-footer__form-message pruv-footer__form-message--success" id="PruvFooterNewsletter-success" tabindex="-1" autofocus>
                {{- 'newsletter.success' | t -}}
              </p>
            {%- endif -%}
          {%- endform -%}
          {%- if section.settings.newsletter_subtext != blank -%}
            <div class="pruv-footer__subtext rte">{{ section.settings.newsletter_subtext }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 2. Brand + link columns on a hairline grid {%- endcomment -%}
    {%- liquid
      assign show_contact_col = false
      if section.settings.phone != blank or section.settings.email != blank
        assign show_contact_col = true
      endif
      if section.settings.show_social and has_social_icons
        assign show_contact_col = true
      endif
    -%}
    <div class="pruv-footer__grid">
      <div class="pruv-footer__brand">
        {%- assign footer_logo_width = section.settings.logo_width | default: 220 -%}
        <a href="{{ routes.root_url }}" class="pruv-footer__brand-link" style="--footer-logo-width: {{ footer_logo_width }}px;">
          {%- if settings.logo != blank -%}
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            <span class="pruv-footer__logo-wrapper">
              {{
                settings.logo
                | image_url: width: 800
                | image_tag:
                  class: 'pruv-footer__logo',
                  alt: logo_alt,
                  loading: 'lazy',
                  widths: '200, 300, 400, 600, 800',
                  sizes: '(min-width: 750px) 320px, 60vw'
              }}
            </span>
          {%- else -%}
            <span class="pruv-footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="pruv-footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
      </div>

      <div class="pruv-footer__cols">
      {%- if section.blocks.size > 0 -%}
        <nav class="pruv-footer__col" aria-label="{{ section.settings.links_heading | default: 'Footer' | escape }}">
          {%- if section.settings.links_heading != blank -%}
            <p class="pruv-footer__col-heading">{{ section.settings.links_heading | escape }}</p>
          {%- endif -%}
          <ul class="pruv-footer__list list-unstyled">
            {%- for block in section.blocks -%}
              {%- liquid
                assign link_url = block.settings.url
                if link_url == blank
                  assign lower_label = block.settings.label | downcase
                  if lower_label contains 'contact'
                    assign link_url = '/pages/contact'
                  endif
                endif
              -%}
              <li {{ block.shopify_attributes }}>
                <a
                  {% if link_url == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ link_url }}"
                  {% endif %}
                  class="pruv-footer__link"
                >
                  <span class="pruv-footer__link-text">{{ block.settings.label | escape }}</span>
                  <span class="pruv-footer__link-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="pruv-footer__col">
        {%- if section.settings.help_heading != blank -%}
          <p class="pruv-footer__col-heading">{{ section.settings.help_heading | escape }}</p>
        {%- endif -%}
        <ul class="pruv-footer__list list-unstyled">
          {%- if section.settings.contact_link_label != blank -%}
            {%- assign footer_contact_url = section.settings.contact_link_url | default: '/pages/contact' -%}
            <li>
              <a href="{{ footer_contact_url }}" class="pruv-footer__link">
                <span class="pruv-footer__link-text">{{ section.settings.contact_link_label | escape }}</span>
                <span class="pruv-footer__link-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.show_policies -%}
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <a href="{{ policy.url }}" class="pruv-footer__link">
                    <span class="pruv-footer__link-text">{{ policy.title | escape }}</span>
                    <span class="pruv-footer__link-arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>

      {%- if show_contact_col -%}
        <div class="pruv-footer__col">
          <p class="pruv-footer__col-heading">Contact</p>
          <ul class="pruv-footer__list list-unstyled">
            {%- if section.settings.phone != blank -%}
              <li>
                <a class="pruv-footer__link" href="tel:{{ section.settings.phone | remove: ' ' }}">
                  <span class="pruv-footer__link-text">{{ section.settings.phone | escape }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <li>
                <a class="pruv-footer__link" href="mailto:{{ section.settings.email }}">
                  <span class="pruv-footer__link-text">{{ section.settings.email | escape }}</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
          {%- if section.settings.show_social and has_social_icons -%}
            {%- render 'social-icons', class: 'pruv-footer__social' -%}
          {%- endif -%}
        </div>
      {%- endif -%}
      </div>
    </div>

    {%- comment -%} 3. Bottom bar {%- endcomment -%}
    <div class="pruv-footer__bottom">
      <p class="pruv-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.legal_entity | default: shop.name | escape }}. All rights reserved.
        {%- if section.settings.registration_number != blank %} {{ section.settings.registration_number | escape }}{% endif -%}
      </p>

      {%- if section.settings.payment_enable -%}
        <div class="pruv-footer__payment">
          <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
          <ul class="list list-payment" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">
                {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <a href="#" class="pruv-footer__top" data-pruv-back-to-top>
        <span>Back to top</span>
        <span class="pruv-footer__top-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none">
            <path d="M12 19V5M6 11l6-6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</footer>

<script>
  (function () {
    var link = document.querySelector('[data-pruv-back-to-top]');
    if (!link) return;
    link.addEventListener('click', function (event) {
      event.preventDefault();
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "Prüv footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the loop"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "richtext",
      "id": "newsletter_subtext",
      "label": "Helper text",
      "default": "<p>We won't spam you, promise. Just useful hair and hard-water science, occasionally.</p>"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "info": "Placeholder — add your real support number before launch."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "info": "Placeholder — add your real support address before launch."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "info": "Pulls from Theme Settings → Social media.",
      "default": true
    },
    {
      "type": "header",
      "content": "Links column"
    },
    {
      "type": "text",
      "id": "links_heading",
      "label": "Heading",
      "default": "Explore"
    },
    {
      "type": "header",
      "content": "\"Need help?\" column"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Heading",
      "default": "Need help?"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show shop policies",
      "info": "Auto-populated from Settings → Policies.",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_link_label",
      "label": "Contact link label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_link_url",
      "label": "Contact link URL",
      "info": "Placeholder — point at your Contact page once created."
    },
    {
      "type": "header",
      "content": "Payment icons"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show accepted payment icons",
      "default": false
    },
    {
      "type": "header",
      "content": "Logo lockup"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 220
    },
    {
      "type": "checkbox",
      "id": "invert_logo_for_dark",
      "label": "Enhance logo contrast on dark background",
      "info": "Brightens the dark lettering while keeping copper dots intact.",
      "default": true
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline under logo",
      "default": "Beyond Doubt"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "legal_entity",
      "label": "Registered legal entity name",
      "info": "Placeholder — enter your actual registered company name. Falls back to the shop name if left blank."
    },
    {
      "type": "text",
      "id": "registration_number",
      "label": "Registration / CIN number",
      "info": "Placeholder — optional, omitted from the copyright line if left blank."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Flat link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
