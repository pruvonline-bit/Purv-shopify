<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500;600&display=swap"
  rel="stylesheet"
>
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'section-pruv-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_social_icons = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_snapchat_link != blank or settings.social_tumblr_link != blank or settings.social_vimeo_link != blank
    assign has_social_icons = true
  endif
-%}

<footer class="pruv-footer color-{{ section.settings.color_scheme }}">
  <div class="pruv-footer__panel">
    <div class="pruv-footer__row page-width">
      <div class="pruv-footer__col pruv-footer__col--newsletter">
        {%- if section.settings.newsletter_enable -%}
          {%- if section.settings.newsletter_eyebrow != blank -%}
            <p class="pruv-footer__eyebrow">{{ section.settings.newsletter_eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="pruv-footer__heading">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}

          {%- form 'customer', id: 'PruvFooterNewsletter', class: 'newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter-form__field-wrapper">
              <div class="field">
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="field__input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="PruvFooterNewsletter-error"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="PruvFooterNewsletter-success"
                  {% endif %}
                  placeholder="Your email address"
                  required
                >
                <label class="field__label" for="NewsletterForm--{{ section.id }}">Your email address</label>
                <button
                  type="submit"
                  class="newsletter-form__button field__button"
                  name="commit"
                  aria-label="{{ 'newsletter.button_label' | t }}"
                >
                  <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                </button>
              </div>
              {%- if form.errors -%}
                <small class="newsletter-form__message form__message" id="PruvFooterNewsletter-error">
                  <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </small>
              {%- endif -%}
            </div>
            {%- if form.posted_successfully? -%}
              <h3
                class="newsletter-form__message newsletter-form__message--success form__message"
                id="PruvFooterNewsletter-success"
                tabindex="-1"
                autofocus
              >
                <span class="svg-wrapper">{{- 'icon-success.svg' | inline_asset_content -}}</span>
                {{- 'newsletter.success' | t }}
              </h3>
            {%- endif -%}
          {%- endform -%}

          {%- if section.settings.newsletter_subtext != blank -%}
            <div class="pruv-footer__subtext rte">{{ section.settings.newsletter_subtext }}</div>
          {%- endif -%}
        {%- endif -%}

        <div class="pruv-footer__contact-row">
          <div class="pruv-footer__contact-links">
            {%- if section.settings.phone != blank -%}
              <a class="pruv-footer__contact-item" href="tel:{{ section.settings.phone | remove: ' ' }}">
                <svg class="pruv-footer__contact-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M7.5 3.5C6.5 3.5 5.5 4.3 5.2 5.4C4.6 8 5.4 11.5 8.2 14.8C11 18.1 14.2 19.7 16.9 19.4C18.1 19.3 19.1 18.4 19.4 17.2L19.9 15.3C20 14.9 19.8 14.5 19.4 14.3L16.4 13C16 12.8 15.6 12.9 15.3 13.2L14.2 14.5C12.4 13.5 11 11.9 10.2 10L11.4 8.8C11.7 8.5 11.7 8.1 11.6 7.7L10.4 4.6C10.2 4.2 9.8 4 9.4 4.1L7.5 3.5Z"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linejoin="round"
                  />
                </svg>
                {{ section.settings.phone }}
              </a>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <a class="pruv-footer__contact-item" href="mailto:{{ section.settings.email }}">
                <svg class="pruv-footer__contact-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3.5" y="5.5" width="17" height="13" rx="2" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M4.5 7L12 12.5L19.5 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ section.settings.email }}
              </a>
            {%- endif -%}
          </div>
          {%- if section.settings.show_social and has_social_icons -%}
            {%- render 'social-icons', class: 'pruv-footer__social' -%}
          {%- endif -%}
        </div>
      </div>

      <div class="pruv-footer__col pruv-footer__col--links">
        {%- if section.blocks.size > 0 -%}
          <div class="pruv-footer__link-group">
            {%- for block in section.blocks -%}
              <div class="pruv-footer__link-item" {{ block.shopify_attributes }}>
                <a
                  {% if block.settings.url == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.url }}"
                  {% endif %}
                  class="pruv-footer__link"
                >
                  {{- block.settings.label | escape -}}
                </a>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="pruv-footer__help">
          {%- if section.settings.help_heading != blank -%}
            <p class="pruv-footer__help-heading">{{ section.settings.help_heading | escape }}</p>
          {%- endif -%}
          <ul class="pruv-footer__help-list list-unstyled">
            {%- if section.settings.contact_link_label != blank -%}
              <li>
                <a
                  {% if section.settings.contact_link_url == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ section.settings.contact_link_url }}"
                  {% endif %}
                >
                  {{- section.settings.contact_link_label | escape -}}
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.show_policies -%}
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>

        {%- if section.settings.payment_enable -%}
          <div class="pruv-footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="pruv-footer__brand page-width">
    {%- if settings.logo != blank -%}
      {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
      {{
        settings.logo
        | image_url: width: 400
        | image_tag: class: 'pruv-footer__logo', alt: logo_alt, widths: '100, 150, 200, 300, 400'
      }}
    {%- else -%}
      <p class="pruv-footer__logo-text">{{ shop.name }}</p>
    {%- endif -%}
    {%- if section.settings.tagline != blank -%}
      <p class="pruv-footer__tagline">{{ section.settings.tagline | escape }}</p>
    {%- endif -%}
    <p class="pruv-footer__copyright">
      &copy; {{ 'now' | date: '%Y' }} {{ section.settings.legal_entity | default: shop.name | escape }}. All rights reserved.
      {%- if section.settings.registration_number != blank %} {{ section.settings.registration_number | escape }}{% endif -%}
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Prüv footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the loop"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "richtext",
      "id": "newsletter_subtext",
      "label": "Helper text",
      "default": "<p>We won't spam you, promise. Just useful hair and hard-water science, occasionally.</p>"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "info": "Placeholder — add your real support number before launch."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "info": "Placeholder — add your real support address before launch."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "info": "Pulls from Theme Settings → Social media.",
      "default": true
    },
    {
      "type": "header",
      "content": "\"Need help?\" column"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Heading",
      "default": "Need help?"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show shop policies",
      "info": "Auto-populated from Settings → Policies.",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_link_label",
      "label": "Contact link label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_link_url",
      "label": "Contact link URL",
      "info": "Placeholder — point at your Contact page once created."
    },
    {
      "type": "header",
      "content": "Payment icons"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show accepted payment icons",
      "default": false
    },
    {
      "type": "header",
      "content": "Logo lockup"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline under logo",
      "default": "Beyond Doubt"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "legal_entity",
      "label": "Registered legal entity name",
      "info": "Placeholder — enter your actual registered company name. Falls back to the shop name if left blank."
    },
    {
      "type": "text",
      "id": "registration_number",
      "label": "Registration / CIN number",
      "info": "Placeholder — optional, omitted from the copyright line if left blank."
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Flat link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
