{%- comment -%}
  Pill tab switcher between related pages (e.g. the Vector-5 product page and the
  Hair VivinePro science page). The tab whose link matches the current URL is highlighted.
{%- endcomment -%}
{%- liquid
  assign show_tabs = true
  if section.settings.only_product != blank
    if product == blank or product.id != section.settings.only_product.id
      assign show_tabs = false
    endif
  endif
-%}

{%- if show_tabs and section.blocks.size > 0 -%}
  {%- style -%}
    .pruv-page-tabs-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .pruv-page-tabs-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .pruv-page-tabs {
      background: #FAF6F0;
      border-bottom: 1px solid rgba(27, 29, 31, 0.06);
    }

    .pruv-page-tabs__list {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2.4rem;
      margin: 0 auto;
      padding-top: 0;
      padding-bottom: 0;
      list-style: none;
    }

    .pruv-page-tabs__link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 4.4rem;
      padding: 0.8rem 3rem;
      border: 1px solid transparent;
      border-radius: 999px;
      font-family: 'Geist', system-ui, sans-serif;
      font-size: 1.6rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-decoration: none;
      color: #8A8175;
      transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    }

    .pruv-page-tabs__link:hover {
      color: #1B1D1F;
    }

    .pruv-page-tabs__link.is-active {
      color: #B87333;
      background: rgba(184, 115, 51, 0.08);
      border-color: rgba(184, 115, 51, 0.5);
      box-shadow: 0 4px 14px rgba(184, 115, 51, 0.18);
    }

    @media screen and (max-width: 749px) {
      .pruv-page-tabs__list {
        gap: 0.8rem;
      }

      .pruv-page-tabs__link {
        min-height: 4rem;
        padding: 0.6rem 2rem;
        font-size: 1.4rem;
      }
    }
  {%- endstyle -%}

  <nav class="pruv-page-tabs pruv-page-tabs-{{ section.id }}" aria-label="{{ section.settings.aria_label | escape }}">
    <ul class="pruv-page-tabs__list page-width" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign link_path = block.settings.link | split: '?' | first | split: '#' | first
          assign is_active = false
          if link_path != blank and link_path != '/'
            if request.path == link_path
              assign is_active = true
            elsif request.path contains link_path
              assign is_active = true
            endif
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="pruv-page-tabs__link{% if is_active %} is-active{% endif %}"
            {% if is_active %}
              aria-current="page"
            {% endif %}
          >
            {{- block.settings.label | escape -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Prüv page tabs",
  "tag": "section",
  "class": "section pruv-page-tabs-section",
  "settings": [
    {
      "type": "product",
      "id": "only_product",
      "label": "Only show on this product",
      "info": "On product pages, the tabs appear only for this product. Leave empty to show everywhere this section is added."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Product and science pages"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Tab"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "The tab is highlighted when the visitor is on this page."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Prüv page tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Prüv" } },
        { "type": "tab", "settings": { "label": "VivinePro" } }
      ]
    }
  ]
}
{% endschema %}
