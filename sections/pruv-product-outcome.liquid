{{ 'section-pruv-outcome.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pruv-outcome.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="pruv-outcome color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <!-- Header -->
    <div class="pruv-outcome__header" data-outcome-header>
      {%- if section.settings.eyebrow != blank -%}
        <p class="pruv-outcome__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pruv-outcome__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pruv-outcome__subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <!-- Dual Pillar Grid: Who It Is For & What It Helps With -->
    <div class="pruv-outcome__grid">
      <!-- Pillar 1: Who It Is For -->
      <div class="pruv-outcome__col pruv-outcome__col--for" data-outcome-card>
        <div class="pruv-outcome__col-head">
          <div class="pruv-outcome__col-badge">TARGET CONCERNS</div>
          <h3 class="pruv-outcome__col-title">{{ section.settings.who_title | default: 'Who This Is Built For' }}</h3>
          <p class="pruv-outcome__col-desc">Designed for anyone noticing early-to-moderate hair thinning, shedding, or root weakness.</p>
        </div>

        <div class="pruv-outcome__items-list">
          <div class="pruv-outcome__concern-item">
            <div class="pruv-outcome__concern-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <div class="pruv-outcome__concern-body">
              <h4 class="pruv-outcome__concern-name">Excessive Daily Shedding</h4>
              <p class="pruv-outcome__concern-text">Finding noticeable bunches of hair on your pillow, in the shower drain, or on your brush.</p>
            </div>
          </div>

          <div class="pruv-outcome__concern-item">
            <div class="pruv-outcome__concern-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div class="pruv-outcome__concern-body">
              <h4 class="pruv-outcome__concern-name">Widening Part & Thinning Crown</h4>
              <p class="pruv-outcome__concern-text">More scalp visibly showing through your natural parting line or around the crown area.</p>
            </div>
          </div>

          <div class="pruv-outcome__concern-item">
            <div class="pruv-outcome__concern-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="pruv-outcome__concern-body">
              <h4 class="pruv-outcome__concern-name">Receding Temples & Edges</h4>
              <p class="pruv-outcome__concern-text">Miniaturizing or weakened baby hairs along your hairline and temples that struggle to grow.</p>
            </div>
          </div>

          <div class="pruv-outcome__concern-item">
            <div class="pruv-outcome__concern-icon">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            </div>
            <div class="pruv-outcome__concern-body">
              <h4 class="pruv-outcome__concern-name">Hard Water & Scalp Stress</h4>
              <p class="pruv-outcome__concern-text">Brittle strands prone to snapping due to harsh mineral deposits and tap water impurities.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Pillar 2: What It Helps With (Consumer First, Science Second) -->
      <div class="pruv-outcome__col pruv-outcome__col--helps" data-outcome-card>
        <div class="pruv-outcome__col-head">
          <div class="pruv-outcome__col-badge pruv-outcome__col-badge--copper">PROVEN IMPACT</div>
          <h3 class="pruv-outcome__col-title">{{ section.settings.helps_title | default: 'What It Transforms' }}</h3>
          <p class="pruv-outcome__col-desc">Consumer-first benefits upfront, backed by clinical actives to validate every claim.</p>
        </div>

        <div class="pruv-outcome__items-list">
          <div class="pruv-outcome__benefit-item">
            <div class="pruv-outcome__benefit-check">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div class="pruv-outcome__benefit-body">
              <h4 class="pruv-outcome__benefit-name">Anchors Hair Firmly at the Root</h4>
              <p class="pruv-outcome__benefit-text">Significantly cuts daily premature fall by reinforcing the dermal root sheath that holds each strand.</p>
              <span class="pruv-outcome__science-tag">Science: 2% Procapil™ + Copper Tripeptides</span>
            </div>
          </div>

          <div class="pruv-outcome__benefit-item">
            <div class="pruv-outcome__benefit-check">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div class="pruv-outcome__benefit-body">
              <h4 class="pruv-outcome__benefit-name">Wakes Up Sluggish Hair Follicles</h4>
              <p class="pruv-outcome__benefit-text">Jumpstarts dormant roots back into active hair-producing cycles for denser new sprout growth.</p>
              <span class="pruv-outcome__science-tag">Science: 3% Redensyl™ + Anagain™ Extract</span>
            </div>
          </div>

          <div class="pruv-outcome__benefit-item">
            <div class="pruv-outcome__benefit-check">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div class="pruv-outcome__benefit-body">
              <h4 class="pruv-outcome__benefit-name">Neutralizes Mineral Buildup</h4>
              <p class="pruv-outcome__benefit-text">Prevents hard water calcium and heavy metals from choking the scalp without stripping natural lipids.</p>
              <span class="pruv-outcome__science-tag">Science: Bio-Chelating Adaptogens</span>
            </div>
          </div>

          <div class="pruv-outcome__benefit-item">
            <div class="pruv-outcome__benefit-check">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div class="pruv-outcome__benefit-body">
              <h4 class="pruv-outcome__benefit-name">Water-Light with Zero Sticky Residue</h4>
              <p class="pruv-outcome__benefit-text">Absorbs cleanly into scalp tissue in 3 seconds. Won't weigh hair down or alter your daily styling.</p>
              <span class="pruv-outcome__science-tag">Science: 100% Lipid-Free Aqueous Elixir</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pillar 3: Expected Result Timeline -->
    <div class="pruv-outcome__timeline-wrap" data-outcome-timeline>
      <div class="pruv-outcome__timeline-intro">
        <span class="pruv-outcome__col-badge">THE 90-DAY JOURNEY</span>
        <h3 class="pruv-outcome__timeline-heading">{{ section.settings.timeline_title | default: 'Expected Result Timeline' }}</h3>
        <p class="pruv-outcome__timeline-sub">Hair recovery works with your natural biological growth cycle. Here is what you can realistically expect:</p>
      </div>

      <!-- Stepper Nav (Mobile/Desktop Interactive) -->
      <div class="pruv-outcome__stepper-nav" role="tablist">
        <button type="button" class="pruv-outcome__step-btn is-active" data-phase-target="0" role="tab" aria-selected="true">
          <span class="pruv-outcome__step-num">01</span>
          <span class="pruv-outcome__step-text">Days 1–30</span>
        </button>
        <button type="button" class="pruv-outcome__step-btn" data-phase-target="1" role="tab" aria-selected="false">
          <span class="pruv-outcome__step-num">02</span>
          <span class="pruv-outcome__step-text">Days 31–60</span>
        </button>
        <button type="button" class="pruv-outcome__step-btn" data-phase-target="2" role="tab" aria-selected="false">
          <span class="pruv-outcome__step-num">03</span>
          <span class="pruv-outcome__step-text">Days 61–90+</span>
        </button>
      </div>

      <!-- Animated Progress Rail -->
      <div class="pruv-outcome__rail-container" aria-hidden="true">
        <div class="pruv-outcome__rail-bg">
          <div class="pruv-outcome__rail-fill" data-timeline-fill style="width: 33%;"></div>
        </div>
      </div>

      <!-- 3 Phase Cards Grid -->
      <div class="pruv-outcome__timeline-cards">
        <!-- Phase 1 -->
        <div class="pruv-outcome__phase-card is-active" data-phase-card="0">
          <div class="pruv-outcome__phase-top">
            <span class="pruv-outcome__phase-badge">PHASE 01 • WEEKS 1–4</span>
            <span class="pruv-outcome__phase-tag">DAYS 1–30</span>
          </div>
          <h4 class="pruv-outcome__phase-title">The Shedding Reset</h4>
          <div class="pruv-outcome__phase-section">
            <span class="pruv-outcome__phase-label">WHAT YOU SEE & FEEL:</span>
            <p class="pruv-outcome__phase-consumer">Noticeable reduction in daily hair fall. Strands feel stronger during showers and brushing. Scalp feels calm, non-itchy, and refreshed.</p>
          </div>
          <div class="pruv-outcome__phase-section pruv-outcome__phase-section--science">
            <span class="pruv-outcome__phase-label">BEHIND THE SCENES:</span>
            <p class="pruv-outcome__phase-sci">Follicle anchoring strengthens, stabilizing the early anagen growth phase and micro-clearing mineral calcification.</p>
          </div>
        </div>

        <!-- Phase 2 -->
        <div class="pruv-outcome__phase-card" data-phase-card="1">
          <div class="pruv-outcome__phase-top">
            <span class="pruv-outcome__phase-badge">PHASE 02 • WEEKS 5–8</span>
            <span class="pruv-outcome__phase-tag">DAYS 31–60</span>
          </div>
          <h4 class="pruv-outcome__phase-title">The Sprouting Phase</h4>
          <div class="pruv-outcome__phase-section">
            <span class="pruv-outcome__phase-label">WHAT YOU SEE & FEEL:</span>
            <p class="pruv-outcome__phase-consumer">Fine baby hairs start emerging along hairline and parting edges. Hair feels bouncier and has improved root lift throughout the day.</p>
          </div>
          <div class="pruv-outcome__phase-section pruv-outcome__phase-section--science">
            <span class="pruv-outcome__phase-label">BEHIND THE SCENES:</span>
            <p class="pruv-outcome__phase-sci">Dormant hair matrix cells reactivate; dermal papilla proliferation accelerates blood micro-circulation directly to the root.</p>
          </div>
        </div>

        <!-- Phase 3 -->
        <div class="pruv-outcome__phase-card" data-phase-card="2">
          <div class="pruv-outcome__phase-top">
            <span class="pruv-outcome__phase-badge">PHASE 03 • WEEKS 9–12</span>
            <span class="pruv-outcome__phase-tag">DAYS 61–90+</span>
          </div>
          <h4 class="pruv-outcome__phase-title">Visible Density & Fullness</h4>
          <div class="pruv-outcome__phase-section">
            <span class="pruv-outcome__phase-label">WHAT YOU SEE & FEEL:</span>
            <p class="pruv-outcome__phase-consumer">Parting lines appear visibly fuller and tighter. Hair shafts feel thicker and stronger with resilient, long-lasting density.</p>
          </div>
          <div class="pruv-outcome__phase-section pruv-outcome__phase-section--science">
            <span class="pruv-outcome__phase-label">BEHIND THE SCENES:</span>
            <p class="pruv-outcome__phase-sci">Keratin shaft diameter expands; healthy continuous growth cycles establish for long-term sustained follicle longevity.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Assurance Badges Footer Strip -->
    <div class="pruv-outcome__assurance-strip" data-outcome-assurance>
      <div class="pruv-outcome__assurance-item">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>100% Drug-Free Formula</span>
      </div>
      <div class="pruv-outcome__assurance-divider" aria-hidden="true">•</div>
      <div class="pruv-outcome__assurance-item">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Safe For Daily Ongoing Use</span>
      </div>
      <div class="pruv-outcome__assurance-divider" aria-hidden="true">•</div>
      <div class="pruv-outcome__assurance-item">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>Dermatologically Certified Safe</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prüv Outcome & Timeline",
  "tag": "section",
  "class": "section pruv-outcome-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE PRÜV PROMISE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results You Can Measure"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clear answers on who this helps, what it transforms, and when you can expect real changes."
    },
    {
      "type": "header",
      "content": "Pillars"
    },
    {
      "type": "text",
      "id": "who_title",
      "label": "Pillar 1 Title",
      "default": "Who This Is Built For"
    },
    {
      "type": "text",
      "id": "helps_title",
      "label": "Pillar 2 Title",
      "default": "What It Transforms"
    },
    {
      "type": "text",
      "id": "timeline_title",
      "label": "Timeline Title",
      "default": "Expected Result Timeline"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
        {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Padding top",
          "default": 36
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "label": "Padding bottom",
          "default": 36
        }
  ],
  "presets": [
    {
      "name": "Prüv Outcome & Timeline"
    }
  ]
}
{% endschema %}
