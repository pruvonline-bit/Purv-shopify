<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{{ 'section-pruv-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #PruvCollectionHero-{{ section.id }} {
    --hero-pos-x: {{ section.settings.canvas_pos_x | default: 50 }}%;
    --hero-pos-y: {{ section.settings.canvas_pos_y | default: 50 }}%;
    --hero-max-width: {{ section.settings.canvas_max_width | default: 660 }}px;
    --hero-mob-pos-x: {{ section.settings.mobile_canvas_pos_x | default: 50 }}%;
    --hero-mob-pos-y: {{ section.settings.mobile_canvas_pos_y | default: 85 }}%;
    --hero-mob-max-width: {{ section.settings.mobile_canvas_max_width | default: 420 }}px;
  }

  #PruvCollectionHero-{{ section.id }} .pruv-collection-hero__media::after {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    {%- if section.settings.overlay_style == 'solid' -%}
      background: rgba(0, 0, 0, 1);
    {%- elsif section.settings.overlay_style == 'subtle-bottom' -%}
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.85) 100%);
    {%- elsif section.settings.overlay_style == 'light-gradient' -%}
      background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.7) 100%);
    {%- else -%}
      background: linear-gradient(180deg, rgba(20, 20, 20, 0.2) 0%, rgba(15, 15, 18, 0.82) 100%);
    {%- endif -%}
  }

  {%- if section.settings.show_ticker and section.settings.ticker_text != blank -%}
    {%- if section.settings.ticker_bg_color != blank -%}
      #PruvCollectionHero-{{ section.id }} .pruv-collection-hero__ticker {
        background-color: {{ section.settings.ticker_bg_color }};
      }
    {%- endif -%}
    {%- if section.settings.ticker_text_color != blank -%}
      #PruvCollectionHero-{{ section.id }} .pruv-collection-hero__ticker,
      #PruvCollectionHero-{{ section.id }} .pruv-collection-hero__ticker-item {
        color: {{ section.settings.ticker_text_color }};
      }
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.button_custom_bg != blank -%}
    #PruvCollectionHero-{{ section.id }} .button--hero-primary {
      background: {{ section.settings.button_custom_bg }} !important;
      background-color: {{ section.settings.button_custom_bg }} !important;
    }
  {%- endif -%}
  {%- if section.settings.button_custom_text != blank -%}
    #PruvCollectionHero-{{ section.id }} .button--hero-primary {
      color: {{ section.settings.button_custom_text }} !important;
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign desktop_img = section.settings.image
  if desktop_img == blank and collection.image != blank
    assign desktop_img = collection.image
  endif

  assign mobile_img = section.settings.image_mobile
  if mobile_img == blank
    assign mobile_img = desktop_img
  endif

  assign hero_heading = section.settings.heading
  assign hero_subheading = section.settings.subheading

  assign btn_label_1 = section.settings.button_label_1 | default: section.settings.button_label
  assign btn_link_1 = section.settings.button_link_1 | default: section.settings.button_link
  assign btn_style_1 = section.settings.button_style_1 | default: 'pill-black'
  assign btn_style_2 = section.settings.button_style_2 | default: 'outline'

  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000'
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign show_content = section.settings.show_content
  if show_content == nil
    assign show_content = true
  endif

  assign show_button_1 = section.settings.show_button_1
  if show_button_1 == nil
    assign show_button_1 = true
  endif

  assign show_button_2 = section.settings.show_button_2
  if show_button_2 == nil
    assign show_button_2 = true
  endif
-%}

<section
  id="PruvCollectionHero-{{ section.id }}"
  class="pruv-collection-hero pruv-collection-hero--desk-{{ section.settings.height }} pruv-collection-hero--mob-{{ section.settings.mobile_height }} pruv-collection-hero--layout-{{ section.settings.layout_type }} pruv-collection-hero--mode-{{ section.settings.position_mode | default: 'grid' }} pruv-collection-hero--mob-pos-{{ section.settings.mobile_content_position | default: 'bottom' }} color-{{ section.settings.color_scheme }}"
>
  <div class="pruv-collection-hero__visual">
    {%- if desktop_img != blank or mobile_img != blank -%}
      <div class="pruv-collection-hero__media">
        <picture class="pruv-collection-hero__picture">
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.image_mobile | image_url: width: 375 }} 375w,
                {{ section.settings.image_mobile | image_url: width: 550 }} 550w,
                {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
                {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
            >
          {%- endif -%}

          {%- if desktop_img != blank -%}
            {{
              desktop_img
              | image_url: width: 3000
              | image_tag:
                sizes: '100vw',
                widths: widths,
                fetchpriority: fetch_priority,
                class: 'pruv-collection-hero__image',
                loading: 'eager'
            }}
          {%- elsif mobile_img != blank -%}
            {{
              mobile_img
              | image_url: width: 1500
              | image_tag:
                sizes: '100vw',
                fetchpriority: fetch_priority,
                class: 'pruv-collection-hero__image',
                loading: 'eager'
            }}
          {%- endif -%}
        </picture>
      </div>
    {%- endif -%}

    <div class="pruv-collection-hero__container page-width">
      {%- if show_content -%}
        {%- if section.settings.eyebrow != blank or hero_heading != blank or hero_subheading != blank or section.settings.promo_code != blank or btn_label_1 != blank or section.settings.button_label_2 != blank -%}
          <div class="pruv-collection-hero__content pruv-collection-hero__content--pos-{{ section.settings.content_position }} pruv-collection-hero__content--mob-align-{{ section.settings.mobile_content_alignment }}">
            {%- if section.settings.eyebrow != blank -%}
              <p class="pruv-collection-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}

            {%- if hero_heading != blank -%}
              <h1 class="pruv-collection-hero__heading pruv-collection-hero__heading--{{ section.settings.heading_size }}">
                {{ hero_heading }}
              </h1>
            {%- endif -%}

            {%- if hero_subheading != blank -%}
              <div class="pruv-collection-hero__subheading rte">
                {{ hero_subheading }}
              </div>
            {%- endif -%}

            {%- if section.settings.promo_code != blank -%}
              <div class="pruv-collection-hero__code-badge">
                <span class="pruv-collection-hero__code-text">Use code: {{ section.settings.promo_code | escape }}</span>
              </div>
            {%- endif -%}

            {%- if show_button_1 or show_button_2 -%}
              <div class="pruv-collection-hero__buttons">
                {%- if show_button_1 and btn_label_1 != blank -%}
                  <a
                    {% if btn_link_1 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ btn_link_1 }}"
                    {% endif %}
                    class="button button--hero button--hero-primary button--hero-{{ btn_style_1 }}"
                  >
                    {{- btn_label_1 | escape -}}
                  </a>
                {%- endif -%}

                {%- if show_button_2 and section.settings.button_label_2 != blank -%}
                  <a
                    {% if section.settings.button_link_2 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ section.settings.button_link_2 }}"
                    {% endif %}
                    class="button button--hero button--hero-secondary button--hero-{{ btn_style_2 }}"
                  >
                    {{- section.settings.button_label_2 | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_promo_badge -%}
        <div class="pruv-collection-hero__promo-badge pruv-collection-hero__promo-badge--{{ section.settings.promo_badge_position }}">
          <div class="pruv-collection-hero__promo-badge-main">
            {%- if section.settings.promo_prefix != blank -%}
              <span class="pruv-collection-hero__promo-prefix">{{ section.settings.promo_prefix | escape }}</span>
            {%- endif -%}
            {%- if section.settings.promo_discount != blank -%}
              <span class="pruv-collection-hero__promo-discount">{{ section.settings.promo_discount | escape }}</span>
            {%- endif -%}
            {%- if section.settings.promo_suffix != blank -%}
              <span class="pruv-collection-hero__promo-suffix">{{ section.settings.promo_suffix | escape }}</span>
            {%- endif -%}
          </div>
          {%- if section.settings.promo_tag != blank -%}
            <div class="pruv-collection-hero__promo-tag">
              <span>{{ section.settings.promo_tag | escape }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_ticker and section.settings.ticker_text != blank -%}
    <div class="pruv-collection-hero__ticker" style="--ticker-duration: {{ section.settings.ticker_speed | default: 22 }}s;">
      <div class="pruv-collection-hero__ticker-track">
        {%- for i in (1..6) -%}
          <div class="pruv-collection-hero__ticker-item" {% if i > 1 %}aria-hidden="true"{% endif %}>
            <span>{{ section.settings.ticker_text | escape }}</span>
            <span class="pruv-collection-hero__ticker-separator" aria-hidden="true">•</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_breadcrumb -%}
    <nav class="pruv-collection-hero__breadcrumb page-width" aria-label="breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="pruv-collection-hero__breadcrumb-divider" aria-hidden="true">/</span>
      <span aria-current="page">
        {%- if collection.title -%}
          {{- collection.title -}}
        {%- else -%}
          {{- 'sections.collection_template.title' | t -}}
        {%- endif -%}
      </span>
    </nav>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Prüv collection hero",
  "tag": "section",
  "class": "section pruv-collection-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Banner Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop background image",
      "info": "Optional. Recommended: 2400 x 900px. If blank, collection image will be used."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile background image",
      "info": "Optional. Recommended: 800 x 1000px. If blank, desktop/collection image will be used."
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout style",
      "options": [
        { "value": "full_width", "label": "Full-width banner" },
        { "value": "contained", "label": "Contained card" }
      ],
      "default": "full_width"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Desktop banner height",
      "options": [
        { "value": "compact", "label": "Compact (45vh)" },
        { "value": "regular", "label": "Regular (55vh)" },
        { "value": "medium", "label": "Medium (60vh)" },
        { "value": "large", "label": "Large (75vh)" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "compact"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile banner height",
      "options": [
        { "value": "compact", "label": "Compact (40vh)" },
        { "value": "medium", "label": "Medium (55vh)" },
        { "value": "large", "label": "Large (70vh)" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "compact"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 35
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "gradient", "label": "Dark smooth gradient" },
        { "value": "subtle-bottom", "label": "Subtle bottom fade" },
        { "value": "solid", "label": "Solid dark overlay" },
        { "value": "light-gradient", "label": "Light soft gradient" }
      ],
      "default": "gradient"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Placement & Positioning"
    },
    {
      "type": "select",
      "id": "position_mode",
      "label": "Positioning mode",
      "options": [
        { "value": "grid", "label": "Standard Grid Anchors" },
        { "value": "canvas", "label": "Freeform Canvas Coordinates (X/Y %)" }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Freeform Canvas Controls"
    },
    {
      "type": "range",
      "id": "canvas_pos_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Desktop X Position (Left to Right)",
      "default": 50,
      "info": "0% = Left edge, 50% = Center, 100% = Right edge"
    },
    {
      "type": "range",
      "id": "canvas_pos_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Desktop Y Position (Top to Bottom)",
      "default": 50,
      "info": "0% = Top edge, 50% = Middle, 100% = Bottom edge"
    },
    {
      "type": "range",
      "id": "canvas_max_width",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Desktop Content Box Max Width",
      "default": 660
    },
    {
      "type": "range",
      "id": "mobile_canvas_pos_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mobile X Position (Left to Right)",
      "default": 50,
      "info": "Active in Canvas Mode"
    },
    {
      "type": "range",
      "id": "mobile_canvas_pos_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mobile Y Position (Top to Bottom)",
      "default": 85,
      "info": "Active in Canvas Mode"
    },
    {
      "type": "range",
      "id": "mobile_canvas_max_width",
      "min": 240,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Mobile Content Box Max Width",
      "default": 420
    },
    {
      "type": "header",
      "content": "Standard Grid Anchor Settings"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Desktop content position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left aligned" },
        { "value": "right", "label": "Right aligned" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Mobile vertical placement (Grid mode)",
      "options": [
        { "value": "bottom", "label": "Bottom of image" },
        { "value": "middle", "label": "Middle of image" },
        { "value": "top", "label": "Top of image" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "label": "Mobile text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Typography & Text"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show text & button content",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Tagline",
      "default": "Limited Time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sale is live! Grab your essentials",
      "info": "Leave blank to use dynamic collection title."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra Large" }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Save on your favourite hair and scalp rituals, for a limited time only.</p>",
      "info": "Leave blank to use dynamic collection description."
    },
    {
      "type": "text",
      "id": "promo_code",
      "label": "Promo code tag",
      "info": "Leave blank to hide. Shown as 'Use code: XXXX'."
    },
    {
      "type": "header",
      "content": "Buttons & CTA"
    },
    {
      "type": "checkbox",
      "id": "show_button_1",
      "label": "Show primary button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },
    {
      "type": "select",
      "id": "button_style_1",
      "label": "First button style",
      "options": [
        { "value": "pill-black", "label": "Pill Black (Sleek Graphite)" },
        { "value": "pill-primary", "label": "Pill Accent / Blue" },
        { "value": "pill-white", "label": "Pill White" },
        { "value": "solid-primary", "label": "Solid Primary" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "pill-black"
    },
    {
      "type": "color",
      "id": "button_custom_bg",
      "label": "Custom button background color",
      "info": "Optional override (e.g. choose your preferred shade of dark/color)"
    },
    {
      "type": "color",
      "id": "button_custom_text",
      "label": "Custom button text color",
      "info": "Optional override"
    },
    {
      "type": "checkbox",
      "id": "show_button_2",
      "label": "Show secondary button",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "Second button style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "pill-white", "label": "Pill White" },
        { "value": "pill-black", "label": "Pill Black" },
        { "value": "solid-secondary", "label": "Solid Secondary" }
      ],
      "default": "outline"
    },
    {
      "type": "header",
      "content": "Promotional Offer Graphic"
    },
    {
      "type": "checkbox",
      "id": "show_promo_badge",
      "label": "Show promotional offer graphic",
      "default": false
    },
    {
      "type": "text",
      "id": "promo_prefix",
      "label": "Promo prefix text",
      "default": "FLAT"
    },
    {
      "type": "text",
      "id": "promo_discount",
      "label": "Promo discount number",
      "default": "25%"
    },
    {
      "type": "text",
      "id": "promo_suffix",
      "label": "Promo suffix text",
      "default": "OFF"
    },
    {
      "type": "text",
      "id": "promo_tag",
      "label": "Promo coupon pill tag",
      "default": "USE CODE | PAYDAY"
    },
    {
      "type": "select",
      "id": "promo_badge_position",
      "label": "Promo badge position",
      "options": [
        { "value": "right", "label": "Right side" },
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left side" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Ticker & Breadcrumb"
    },
    {
      "type": "checkbox",
      "id": "show_ticker",
      "label": "Show promotional ticker bar",
      "default": false
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker text",
      "default": "PAYDAY: SAVE FLAT 25% ON ALL ORDERS. USE PAYDAY"
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Ticker scroll speed",
      "default": 22
    },
    {
      "type": "color",
      "id": "ticker_bg_color",
      "label": "Ticker background color",
      "default": "#7ba4f4"
    },
    {
      "type": "color",
      "id": "ticker_text_color",
      "label": "Ticker text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb navigation",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Prüv collection hero"
    }
  ]
}
{% endschema %}
