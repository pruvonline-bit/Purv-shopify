{{ 'section-pruv-cross-sell.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pruv-cross-sell.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign shampoo_name = 'Trishield Element Defense Shampoo'
  assign serum_name = 'VECTOR-5 Advanced Multi-Pathway Structural Density Serum'
  assign mask_name = 'Breakage Repair Keratin-Ceramide Hair Mask'

  assign current_handle = product.handle
  assign target_handle = 'pruv-1'
  assign concern = ''
  assign headline = ''
  assign current_name = product.title
  assign current_freq = ''
  assign target_name = shampoo_name
  assign target_freq = ''

  if current_handle contains 'product-2' or product.title contains 'VECTOR-5' or product.title contains 'Density' or product.title contains 'Serum'
    assign target_handle = 'pruv-1'
    assign concern = 'Hair looks thinner or density feels reduced'
    assign headline = 'Support the scalp. Start with the environment.'
    assign current_name = serum_name
    assign current_freq = 'Daily'
    assign target_name = shampoo_name
    assign target_freq = '2–3x weekly'
  elsif current_handle contains 'pruv-1' or product.title contains 'Shampoo'
    assign target_handle = 'product-3'
    assign concern = 'Hair feels rough, dull, coated, or flat'
    assign headline = 'Reset buildup. Restore smoothness.'
    assign current_name = shampoo_name
    assign current_freq = '3x weekly'
    assign target_name = mask_name
    assign target_freq = '1x weekly'
  elsif current_handle contains 'product-3' or product.title contains 'Mask'
    assign target_handle = 'pruv-1'
    assign concern = 'Hair breaks, snaps, or feels weak'
    assign headline = 'Clean smarter. Repair stronger.'
    assign current_name = mask_name
    assign current_freq = '1–2x weekly'
    assign target_name = shampoo_name
    assign target_freq = '2–3x weekly'
  endif

  if section.settings.custom_target_product != blank
    assign target_product = section.settings.custom_target_product
    assign target_name = target_product.title
  else
    assign target_product = all_products[target_handle]
  endif

  assign eyebrow_text = section.settings.eyebrow | default: concern | default: 'Complete your regimen'
  assign heading_text = section.settings.heading | default: headline | default: 'Pair it with its regimen partner'

  assign bundle_shampoo = all_products['pruv-1']
  assign bundle_serum = all_products['product-2']
  assign bundle_mask = all_products['product-3']
-%}

<section
  class="pruv-cross-sell color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  data-pruv-cross-sell
  data-section-id="{{ section.id }}"
>
  <div class="page-width">
    <!-- Header -->
    <div class="pruv-cross-sell__header" data-cross-sell-header>
      <div class="pruv-cross-sell__eyebrow">
        <span class="pruv-cross-sell__eyebrow-dot" aria-hidden="true"></span>
        <span>{{ eyebrow_text | escape }}</span>
      </div>
      <h2 class="pruv-cross-sell__title">{{ heading_text }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="pruv-cross-sell__subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <!-- Primary + Cross-sell Pair -->
    <div class="pruv-cross-sell__experience" data-cross-sell-experience>
      <!-- Left: Current Product (Primary) -->
      <div class="pruv-cross-sell__card pruv-cross-sell__card--current">
        <div class="pruv-cross-sell__card-top">
          <span class="pruv-cross-sell__step-pill">PRIMARY • IN HAND</span>
        </div>

        <div class="pruv-cross-sell__media">
          {%- if product.featured_image != blank -%}
            {{
              product.featured_image
              | image_url: width: 600
              | image_tag: loading: 'lazy', alt: product.title, class: 'pruv-cross-sell__img'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'pruv-cross-sell__img' }}
          {%- endif -%}
        </div>

        <div class="pruv-cross-sell__info">
          {%- if current_freq != blank -%}
            <span class="pruv-cross-sell__role">Use {{ current_freq }}</span>
          {%- endif -%}
          <h3 class="pruv-cross-sell__product-title">{{ product.title }}</h3>
          <p class="pruv-cross-sell__price">{{ product.price | money }}</p>
          <div class="pruv-cross-sell__active-status">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Selected In Current View</span>
          </div>
        </div>
      </div>

      <!-- Center: Connector -->
      <div class="pruv-cross-sell__connector" aria-hidden="true">
        <div class="pruv-cross-sell__connector-line"></div>
        <div class="pruv-cross-sell__connector-badge">
          <span class="pruv-cross-sell__connector-plus">+</span>
          <span class="pruv-cross-sell__connector-text">PAIR</span>
        </div>
        <div class="pruv-cross-sell__connector-line"></div>
      </div>

      <!-- Right: Cross-sell Product -->
      {%- if target_product != blank -%}
        <div class="pruv-cross-sell__card pruv-cross-sell__card--target">
          <div class="pruv-cross-sell__card-top">
            <span class="pruv-cross-sell__step-pill pruv-cross-sell__step-pill--target">RECOMMENDED PAIR</span>
          </div>

          <div class="pruv-cross-sell__media">
            {%- if target_product.featured_image != blank -%}
              {{
                target_product.featured_image
                | image_url: width: 600
                | image_tag: loading: 'lazy', alt: target_product.title, class: 'pruv-cross-sell__img'
              }}
            {%- else -%}
              {{ 'product-2' | placeholder_svg_tag: 'pruv-cross-sell__img' }}
            {%- endif -%}
          </div>

          <div class="pruv-cross-sell__info">
            {%- if target_freq != blank -%}
              <span class="pruv-cross-sell__role">Use {{ target_freq }}</span>
            {%- endif -%}
            <h3 class="pruv-cross-sell__product-title">
              <a href="{{ target_product.url }}">{{ target_product.title }}</a>
            </h3>

            <div class="pruv-cross-sell__price-row">
              <span class="pruv-cross-sell__price pruv-cross-sell__price--target">
                {{ target_product.price | money }}
              </span>
              {%- if target_product.compare_at_price > target_product.price -%}
                <span class="pruv-cross-sell__mrp">
                  MRP <s>{{ target_product.compare_at_price | money }}</s>
                </span>
              {%- endif -%}
            </div>

            {%- assign target_variant = target_product.selected_or_first_available_variant -%}
            <button
              type="button"
              class="pruv-cross-sell__add-btn"
              data-cross-sell-add
              data-variant-id="{{ target_variant.id }}"
              {% unless target_variant.available %}
                disabled
              {% endunless %}
            >
              {%- if target_variant.available -%}
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span>+ Add to Bag</span>
              {%- else -%}
                <span>Sold Out</span>
              {%- endif -%}
            </button>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- Pair Regimen -->
    {%- if current_freq != blank and target_freq != blank -%}
      <div class="pruv-cross-sell__regimen" data-cross-sell-regimen>
        <div class="pruv-cross-sell__regimen-head">
          <span class="pruv-cross-sell__regimen-label">YOUR REGIMEN</span>
        </div>
        <ul class="pruv-cross-sell__regimen-list" role="list">
          <li class="pruv-cross-sell__regimen-row">
            <span class="pruv-cross-sell__regimen-name">{{ current_name }}</span>
            <span class="pruv-cross-sell__regimen-freq">{{ current_freq }}</span>
          </li>
          <li class="pruv-cross-sell__regimen-row">
            <span class="pruv-cross-sell__regimen-name">{{ target_name }}</span>
            <span class="pruv-cross-sell__regimen-freq">{{ target_freq }}</span>
          </li>
        </ul>
      </div>
    {%- endif -%}

    <!-- Full Urban Hair-Stress Regimen (3-product bundle) -->
    {%- if bundle_shampoo != blank and bundle_serum != blank and bundle_mask != blank -%}
      {%- liquid
        assign v_shampoo = bundle_shampoo.selected_or_first_available_variant
        assign v_serum = bundle_serum.selected_or_first_available_variant
        assign v_mask = bundle_mask.selected_or_first_available_variant
        assign bundle_total = v_shampoo.price | plus: v_serum.price | plus: v_mask.price
        assign bundle_available = false
        if v_shampoo.available and v_serum.available and v_mask.available
          assign bundle_available = true
        endif
      -%}
      <div class="pruv-cross-sell__bundle" data-cross-sell-bundle>
        <div class="pruv-cross-sell__bundle-head">
          <span class="pruv-cross-sell__regimen-label">FULL URBAN HAIR-STRESS REGIMEN</span>
          <h3 class="pruv-cross-sell__bundle-title">Reset. Support. Repair.</h3>
        </div>

        <ul class="pruv-cross-sell__bundle-list" role="list">
          <li class="pruv-cross-sell__bundle-item">
            <div class="pruv-cross-sell__bundle-thumb">
              {%- if bundle_shampoo.featured_image != blank -%}
                {{ bundle_shampoo.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: bundle_shampoo.title }}
              {%- endif -%}
            </div>
            <div class="pruv-cross-sell__bundle-text">
              <span class="pruv-cross-sell__bundle-step">Reset</span>
              <span class="pruv-cross-sell__regimen-name">{{ shampoo_name }}</span>
              <span class="pruv-cross-sell__regimen-freq">2–4x weekly</span>
            </div>
          </li>
          <li class="pruv-cross-sell__bundle-item">
            <div class="pruv-cross-sell__bundle-thumb">
              {%- if bundle_serum.featured_image != blank -%}
                {{ bundle_serum.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: bundle_serum.title }}
              {%- endif -%}
            </div>
            <div class="pruv-cross-sell__bundle-text">
              <span class="pruv-cross-sell__bundle-step">Support</span>
              <span class="pruv-cross-sell__regimen-name">{{ serum_name }}</span>
              <span class="pruv-cross-sell__regimen-freq">Daily</span>
            </div>
          </li>
          <li class="pruv-cross-sell__bundle-item">
            <div class="pruv-cross-sell__bundle-thumb">
              {%- if bundle_mask.featured_image != blank -%}
                {{ bundle_mask.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: bundle_mask.title }}
              {%- endif -%}
            </div>
            <div class="pruv-cross-sell__bundle-text">
              <span class="pruv-cross-sell__bundle-step">Repair</span>
              <span class="pruv-cross-sell__regimen-name">{{ mask_name }}</span>
              <span class="pruv-cross-sell__regimen-freq">1–2x weekly</span>
            </div>
          </li>
        </ul>

        <div class="pruv-cross-sell__bundle-footer">
          <span class="pruv-cross-sell__price">{{ bundle_total | money }}</span>
          <button
            type="button"
            class="pruv-cross-sell__add-btn pruv-cross-sell__add-btn--bundle"
            data-cross-sell-add
            data-variant-ids="{{ v_shampoo.id }},{{ v_serum.id }},{{ v_mask.id }}"
            {% unless bundle_available %}
              disabled
            {% endunless %}
          >
            {%- if bundle_available -%}
              <span>+ Add Full Regimen to Bag</span>
            {%- else -%}
              <span>Sold Out</span>
            {%- endif -%}
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Prüv Product Cross-Sell",
  "tag": "section",
  "class": "section pruv-product-cross-sell-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow override",
      "info": "Leave blank to show the hair concern for the current product."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to show the regimen headline for the current product."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "product",
      "id": "custom_target_product",
      "label": "Override Cross-sell Product",
      "info": "Leave blank to automatically pair: Serum -> Shampoo, Shampoo -> Mask, Mask -> Shampoo."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Prüv Product Cross-Sell"
    }
  ]
}
{% endschema %}
