{{ 'section-pruv-cross-sell.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pruv-cross-sell.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign current_handle = product.handle
  assign target_handle = ''
  assign current_step_num = '02'
  assign current_step_label = 'Follicle Nutrition'
  assign next_step_num = '01'
  assign next_step_label = 'Scalp Purification'
  assign synergy_title = 'Why They Work Better Together'
  assign synergy_reason = 'Water-soluble peptide actives penetrate 3.2× deeper when the scalp barrier is cleared of hard-water mineral calcification by the Trishield Shampoo.'

  if current_handle contains 'product-2' or product.title contains 'VECTOR-5' or product.title contains 'Density' or product.title contains 'Serum'
    assign target_handle = 'pruv-1'
    assign current_step_num = '02'
    assign current_step_label = 'Follicle Nutrition (Serum)'
    assign next_step_num = '01'
    assign next_step_label = 'Scalp Purification (Shampoo)'
    assign synergy_title = 'The Purification & Penetration Synergy'
    assign synergy_reason = 'Hard water coats scalp pores with insoluble calcium and magnesium deposits. The Trishield Shampoo chelate-cleanses these mineral shields, allowing VECTOR-5 elixir to absorb 3.2× deeper into the dermal papilla.'
  elsif current_handle contains 'pruv-1' or product.title contains 'Shampoo'
    assign target_handle = 'product-3'
    assign current_step_num = '01'
    assign current_step_label = 'Scalp Purification (Shampoo)'
    assign next_step_num = '03'
    assign next_step_label = 'Structural Repair (Mask)'
    assign synergy_title = 'The Cleansing & Sealing Synergy'
    assign synergy_reason = 'Once the hair cuticle is freed from heavy mineral buildup, the Keratin-Ceramide Mask delivers targeted lipid replenishment, sealing micro-fissures in damaged hair shafts and boosting tensile strength.'
  elsif current_handle contains 'product-3' or product.title contains 'Mask'
    assign target_handle = 'pruv-1'
    assign current_step_num = '03'
    assign current_step_label = 'Structural Repair (Mask)'
    assign next_step_num = '01'
    assign next_step_label = 'Scalp Purification (Shampoo)'
    assign synergy_title = 'The Foundation & Fortification Synergy'
    assign synergy_reason = 'Deep fiber repair requires a clean canvas. Using the Trishield Shampoo beforehand prevents heavy metal ions from competing with keratin binding sites on the hair cortex.'
  else
    assign target_handle = 'pruv-1'
  endif

  if section.settings.custom_target_product != blank
    assign target_product = section.settings.custom_target_product
  else
    assign target_product = all_products[target_handle]
  endif
-%}

<section
  class="pruv-cross-sell color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  data-pruv-cross-sell
  data-section-id="{{ section.id }}"
>
  <div class="page-width">
    <!-- Header -->
    <div class="pruv-cross-sell__header" data-cross-sell-header>
      <div class="pruv-cross-sell__eyebrow">
        <span class="pruv-cross-sell__eyebrow-dot" aria-hidden="true"></span>
        <span>{{ section.settings.eyebrow | default: 'COMPLETE YOUR RITUAL' | escape }}</span>
      </div>
      <h2 class="pruv-cross-sell__title">
        {{ section.settings.heading | default: 'Pair With The Next Step For Exponential Results' }}
      </h2>
      <p class="pruv-cross-sell__subtitle">
        {{ section.settings.subheading | default: 'Hair restoration is systemic. No single product works in isolation against environmental buildup and follicle dormancy.' | escape }}
      </p>
    </div>

    <!-- Ritual Pair Experience -->
    <div class="pruv-cross-sell__experience" data-cross-sell-experience>
      <!-- Left: Current Product In Hand -->
      <div class="pruv-cross-sell__card pruv-cross-sell__card--current">
        <div class="pruv-cross-sell__card-top">
          <span class="pruv-cross-sell__step-pill">STEP {{ current_step_num }} • IN HAND</span>
        </div>

        <div class="pruv-cross-sell__media">
          {%- if product.featured_image != blank -%}
            {{
              product.featured_image
              | image_url: width: 600
              | image_tag: loading: 'lazy', alt: product.title, class: 'pruv-cross-sell__img'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'pruv-cross-sell__img' }}
          {%- endif -%}
        </div>

        <div class="pruv-cross-sell__info">
          <span class="pruv-cross-sell__role">{{ current_step_label }}</span>
          <h3 class="pruv-cross-sell__product-title">{{ product.title }}</h3>
          <p class="pruv-cross-sell__price">{{ product.price | money }}</p>
          <div class="pruv-cross-sell__active-status">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Selected In Current View</span>
          </div>
        </div>
      </div>

      <!-- Center: Synergy Connector -->
      <div class="pruv-cross-sell__connector" aria-hidden="true">
        <div class="pruv-cross-sell__connector-line"></div>
        <div class="pruv-cross-sell__connector-badge">
          <span class="pruv-cross-sell__connector-plus">+</span>
          <span class="pruv-cross-sell__connector-text">SYNERGY</span>
        </div>
        <div class="pruv-cross-sell__connector-line"></div>
      </div>

      <!-- Right: Target Next Step Product -->
      {%- if target_product != blank -%}
        <div class="pruv-cross-sell__card pruv-cross-sell__card--target">
          <div class="pruv-cross-sell__card-top">
            <span class="pruv-cross-sell__step-pill pruv-cross-sell__step-pill--target">
              STEP {{ next_step_num }} • RECOMMENDED PAIR
            </span>
          </div>

          <div class="pruv-cross-sell__media">
            {%- if target_product.featured_image != blank -%}
              {{
                target_product.featured_image
                | image_url: width: 600
                | image_tag: loading: 'lazy', alt: target_product.title, class: 'pruv-cross-sell__img'
              }}
            {%- else -%}
              {{ 'product-2' | placeholder_svg_tag: 'pruv-cross-sell__img' }}
            {%- endif -%}
          </div>

          <div class="pruv-cross-sell__info">
            <span class="pruv-cross-sell__role">{{ next_step_label }}</span>
            <h3 class="pruv-cross-sell__product-title">
              <a href="{{ target_product.url }}">{{ target_product.title }}</a>
            </h3>

            <div class="pruv-cross-sell__price-row">
              <span class="pruv-cross-sell__price pruv-cross-sell__price--target">
                {{ target_product.price | money }}
              </span>
              {%- if target_product.compare_at_price > target_product.price -%}
                <span class="pruv-cross-sell__mrp">
                  MRP <s>{{ target_product.compare_at_price | money }}</s>
                </span>
              {%- endif -%}
            </div>

            <!-- 1-Click Direct Add to Cart -->
            {%- assign target_variant = target_product.selected_or_first_available_variant -%}
            <button
              type="button"
              class="pruv-cross-sell__add-btn"
              data-cross-sell-add
              data-variant-id="{{ target_variant.id }}"
              {% unless target_variant.available %}
                disabled
              {% endunless %}
            >
              {%- if target_variant.available -%}
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span>+ Add Step {{ next_step_num }} to Bag</span>
              {%- else -%}
                <span>Sold Out</span>
              {%- endif -%}
            </button>
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- The Biological Synergy Explanation Strip -->
    <div class="pruv-cross-sell__synergy-strip" data-cross-sell-synergy>
      <div class="pruv-cross-sell__synergy-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
          <line x1="9" y1="9" x2="9.01" y2="9"></line>
          <line x1="15" y1="9" x2="15.01" y2="9"></line>
        </svg>
      </div>
      <div class="pruv-cross-sell__synergy-text">
        <h4 class="pruv-cross-sell__synergy-heading">{{ synergy_title }}</h4>
        <p class="pruv-cross-sell__synergy-desc">{{ synergy_reason }}</p>
      </div>
      <div class="pruv-cross-sell__synergy-badge">
        <span>BIO-COMPOUNDING EFFECT</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prüv Product Cross-Sell",
  "tag": "section",
  "class": "section pruv-product-cross-sell-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SYSTEMIC SYNERGY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete Your Ritual: Pair With The Next Product"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hair restoration is systemic. No single formula works in isolation against environmental minerals and follicle dormancy."
    },
    {
      "type": "product",
      "id": "custom_target_product",
      "label": "Override Cross-sell Product",
      "info": "Leave blank to automatically pair: Serum -> Shampoo, Shampoo -> Mask, Mask -> Shampoo."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Prüv Product Cross-Sell"
    }
  ]
}
{% endschema %}
