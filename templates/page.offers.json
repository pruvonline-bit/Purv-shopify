          "type": "question",
          "settings": {
            "question": "My code is not working. What should I do?",
            "answer": "<p>Check that the code is typed exactly as shown and that no other code is already applied. If it still does not work, email <a href=\"mailto:support@getpruv.com\">support@getpruv.com</a> and we'll help.</p>"
          }
        }
