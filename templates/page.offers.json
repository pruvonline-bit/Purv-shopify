        "q_1": {
          "type": "question",
          "settings": {
            "question": "Can I use more than one Prüv discount code?",
            "answer": "<p>No. Only one discount code can be applied per order, and codes cannot be combined or stacked. If you have more than one, use the one that saves you the most at checkout.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Can a discount be applied after I have placed my order?",
            "answer": "<p>Normally, no. Promotional codes cannot be applied to orders that have already been placed.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Is Cash on Delivery available with offers?",
            "answer": "<p>Prüv uses a 100% secure, prepaid-only checkout, so all orders, including discounted ones, are paid online.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Do Prüv offers change?",
            "answer": "<p>Yes, offers change from time to time. This page always shows the codes that are currently live.</p>"
          }
        },
