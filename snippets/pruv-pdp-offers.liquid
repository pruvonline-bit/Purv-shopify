{% doc %}
  Renders the "Extra savings" offer card row on the product page.

  Up to three cards, each defined by the block settings offer_N_title /
  offer_N_subtitle / offer_N_footer / offer_N_icon / offer_N_code.
  A card with a blank title is skipped.

  @param {object} block - The `pruv_offers` block.

  @example
  {% render 'pruv-pdp-offers', block: block %}
{% enddoc %}

{%- liquid
  assign has_offer = false
  if block.settings.offer_1_title != blank or block.settings.offer_2_title != blank or block.settings.offer_3_title != blank
    assign has_offer = true
  endif
-%}

{%- if has_offer -%}
  <div class="pruv-pdp-offers" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <p class="pruv-pdp-offers__label">{{ block.settings.heading | escape }}</p>
    {%- endif -%}
    <div class="pruv-pdp-offers__grid">
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign o_title = block.settings.offer_1_title
              assign o_sub = block.settings.offer_1_subtitle
              assign o_foot = block.settings.offer_1_footer
              assign o_icon = block.settings.offer_1_icon
              assign o_code = block.settings.offer_1_code
            when 2
              assign o_title = block.settings.offer_2_title
              assign o_sub = block.settings.offer_2_subtitle
              assign o_foot = block.settings.offer_2_footer
              assign o_icon = block.settings.offer_2_icon
              assign o_code = block.settings.offer_2_code
            when 3
              assign o_title = block.settings.offer_3_title
              assign o_sub = block.settings.offer_3_subtitle
              assign o_foot = block.settings.offer_3_footer
              assign o_icon = block.settings.offer_3_icon
              assign o_code = block.settings.offer_3_code
          endcase
        -%}
        {%- if o_title != blank -%}
          <div class="pruv-pdp-offers__card">
            <div class="pruv-pdp-offers__body">
              <span class="pruv-pdp-offers__icon" aria-hidden="true">
                {%- case o_icon -%}
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h9A1.5 1.5 0 0 1 15 7.5V16H3V7.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                      <path d="M15 10h3.2l2.3 3v3H15v-6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                      <circle cx="7" cy="17.5" r="1.6" stroke="currentColor" stroke-width="1.4"/>
                      <circle cx="17.5" cy="17.5" r="1.6" stroke="currentColor" stroke-width="1.4"/>
                    </svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <rect x="3.5" y="9" width="17" height="11" rx="1.6" stroke="currentColor" stroke-width="1.4"/>
                      <path d="M2.5 9h19v3.4h-19z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                      <path d="M12 9v11" stroke="currentColor" stroke-width="1.4"/>
                      <path d="M12 9S10.8 4.5 8.6 4.5A2.1 2.1 0 0 0 8.6 9H12Zm0 0s1.2-4.5 3.4-4.5A2.1 2.1 0 0 1 15.4 9H12Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M12 3.2 19 6v6c0 4.2-2.9 7.4-7 8.8-4.1-1.4-7-4.6-7-8.8V6l7-2.8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                      <path d="m9 12 2.2 2.2L15.2 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M20 4c0 9-5.4 13.5-11 13.5A5.5 5.5 0 0 1 5 8.2C8 5 14 6.5 20 4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                      <path d="M4 20c2.5-5 6-8 11-10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.4"/>
                      <path d="m9 15 6-6M9.6 9.6h.01M14.4 14.4h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                {%- endcase -%}
              </span>
              <div>
                <p class="pruv-pdp-offers__title">{{ o_title | escape }}</p>
                {%- if o_sub != blank -%}
                  <p class="pruv-pdp-offers__sub">{{ o_sub | escape }}</p>
                {%- endif -%}
              </div>
            </div>
            {%- if o_foot != blank -%}
              <div class="pruv-pdp-offers__foot">
                <span>{{ o_foot | escape }}</span>
                {%- if o_code != blank -%}
                  <button
                    type="button"
                    class="pruv-pdp-offers__copy"
                    data-pruv-copy="{{ o_code | escape }}"
                    aria-label="Copy discount code {{ o_code | escape }}"
                  >
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.6"/>
                      <path d="M15 6.5A2.5 2.5 0 0 0 12.5 4h-6A2.5 2.5 0 0 0 4 6.5v6A2.5 2.5 0 0 0 6.5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <script>
    (function () {
      if (window.pruvOfferCopyBound) return;
      window.pruvOfferCopyBound = true;
      document.addEventListener('click', function (event) {
        var btn = event.target.closest('[data-pruv-copy]');
        if (!btn) return;
        var code = btn.getAttribute('data-pruv-copy');
        if (!code || !navigator.clipboard) return;
        navigator.clipboard.writeText(code).then(function () {
          btn.classList.add('is-copied');
          var previous = btn.getAttribute('aria-label');
          btn.setAttribute('aria-label', 'Code ' + code + ' copied');
          setTimeout(function () {
            btn.classList.remove('is-copied');
            btn.setAttribute('aria-label', previous);
          }, 1800);
        });
      });
    })();
  </script>
{%- endif -%}
