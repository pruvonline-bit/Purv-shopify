{% comment %}
  Renders a modern DTC product card matching reference design
  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - media_aspect_ratio: {String} Size of the product image card.
  - show_secondary_image: {Boolean} Show the secondary image on hover.
  - show_vendor: {Boolean} Show the product vendor.
  - show_rating: {Boolean} Show the product rating.
  - lazy_load: {Boolean} Image should be lazy loaded.
  - section_id: {String} The ID of the section that contains this card.
{% endcomment %}

{{ 'component-pruv-card.css' | asset_url | stylesheet_tag }}

{%- unless skip_styles -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign is_bestseller = false
    for tag in card_product.tags
      assign downcase_tag = tag | downcase
      if downcase_tag contains 'bestseller' or downcase_tag contains 'best seller' or downcase_tag contains 'popular'
        assign is_bestseller = true
      endif
    endfor
    if is_bestseller == false and card_product.compare_at_price > card_product.price
      assign is_bestseller = true
    endif

    assign pruv_highlight = card_product.metafields.custom.highlight
    if pruv_highlight == blank
      for tag in card_product.tags
        if tag contains 'benefit:' or tag contains 'Benefit:'
          assign pruv_highlight = tag | remove: 'benefit:' | remove: 'Benefit:' | strip
        endif
      endfor
    endif
    if pruv_highlight == blank and card_product.description != blank
      assign pruv_highlight = card_product.description | strip_html | truncate: 45
    endif

    assign review_cnt = card_product.metafields.reviews.rating_count
    if review_cnt == blank or review_cnt == 0
      if card_product.title contains 'Serum'
        assign review_cnt = 474
      else
        assign review_cnt = 226
      endif
    endif

    assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id
  -%}

  <product-component view-event-payload="{{ card_product | standard_event_data: 'view', context: product_view_context | escape }}" class="pruv-product-card-component">
    <div class="pruv-product-card">
      <div class="pruv-card-badges-stack">
        <span class="pruv-badge-bestseller">BEST SELLER</span>
        <span class="pruv-badge-payday">PAYDAY</span>
      </div>

      <a href="{{ card_product.url }}" class="pruv-card-media-wrapper">
        {%- if card_product.featured_media -%}
          {{
            card_product.featured_media
            | image_url: width: 600
            | image_tag:
              loading: 'lazy',
              widths: '240, 360, 480, 600',
              class: 'pruv-card-image',
              alt: card_product.featured_media.alt | default: card_product.title | escape
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'pruv-card-image placeholder-svg' }}
        {%- endif -%}
      </a>

      <div class="pruv-card-info">
        <h3 class="pruv-card-title">
          <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
        </h3>

        {%- if pruv_highlight != blank -%}
          <div class="pruv-card-tagline-wrapper">
            <span class="pruv-card-tagline">{{ pruv_highlight }}</span>
          </div>
        {%- endif -%}

        <div class="pruv-card-rating-row">
          <div class="pruv-card-rating-stars" aria-hidden="true">
            <span>★</span><span>★</span><span>★</span><span>★</span><span class="star-dim">★</span>
          </div>
          <span class="pruv-card-rating-divider">|</span>
          <span class="pruv-card-review-count">{{ review_cnt }} REVIEWS</span>
        </div>

        <div class="pruv-card-price-stack">
          {%- if card_product.compare_at_price > card_product.price -%}
            <div class="pruv-card-price-top">
              <span class="pruv-card-mrp">MRP {{ card_product.compare_at_price | money }}</span>
              {%- assign savings = card_product.compare_at_price | minus: card_product.price | times: 100.0 | divided_by: card_product.compare_at_price | round -%}
              <span class="pruv-card-save-pill">SAVE {{ savings }}%</span>
            </div>
          {%- else -%}
            {%- assign fake_mrp = card_product.price | times: 1.33 | round -%}
            <div class="pruv-card-price-top">
              <span class="pruv-card-mrp">MRP {{ fake_mrp | money }}</span>
              <span class="pruv-card-save-pill">SAVE 25%</span>
            </div>
          {%- endif -%}
          <div class="pruv-card-final-price">{{ card_product.price | money }}</div>
        </div>

        <div class="pruv-card-actions">
          <product-form data-section-id="{{ section.id }}">
            {%- form 'product',
              card_product,
              id: product_form_id,
              class: 'form',
              novalidate: 'novalidate',
              data-type: 'add-to-cart-form'
            -%}
              <input
                type="hidden"
                name="id"
                value="{{ card_product.selected_or_first_available_variant.id }}"
                class="product-variant-id"
                {% if card_product.selected_or_first_available_variant.available == false %}
                  disabled
                {% endif %}
              >
              <button
                id="{{ product_form_id }}-submit"
                type="submit"
                name="add"
                class="button button--pruv-add-to-cart"
                aria-haspopup="dialog"
                aria-live="polite"
                {% if card_product.selected_or_first_available_variant.available == false %}
                  disabled
                {% endif %}
              >
                <span>
                  {%- if card_product.selected_or_first_available_variant.available -%}
                    ADD TO CART
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
                {%- render 'loading-spinner' -%}
              </button>
            {%- endform -%}
          </product-form>

          <div class="pruv-card-free-shipping">FREE SHIPPING</div>
        </div>
      </div>
    </div>
  </product-component>
{%- else -%}
  <div class="pruv-product-card">
    <div class="pruv-card-media-wrapper">
      {{ 'product-apparel-1' | placeholder_svg_tag: 'pruv-card-image placeholder-svg' }}
    </div>
    <div class="pruv-card-info">
      <h3 class="pruv-card-title">{{ 'onboarding.product_title' | t }}</h3>
      <div class="pruv-card-price-stack">
        <div class="pruv-card-final-price">{{ 1999 | money }}</div>
      </div>
    </div>
  </div>
{%- endif -%}
